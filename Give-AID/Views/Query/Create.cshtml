@* Query/Create — form to submit a new support query *@
@{
    ViewData["Title"] = "Submit a Query";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            @* ── Card wrapper ────────────────────────────────────── *@
            <div class="giveaid-card p-4 p-md-5">

                @* ── Form heading ────────────────────────────────── *@
                <div class="text-center mb-4">
                    <i class="bi bi-chat-dots" style="font-size:2.5rem; color:#1E8E5A;"></i>
                    <h3 class="fw-bold mt-2" style="color:#1E8E5A;">Submit a Query</h3>
                    <p class="text-muted">Our support team usually replies within 24 hours.</p>
                </div>

                @* ── Error message ───────────────────────────────── *@
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @* ── Query form ──────────────────────────────────── *@
                @* Action posts to QueryController.Create — antiforgery token is required *@
                <form method="post" action="/Query/Create">
                    @Html.AntiForgeryToken()

                    @* Subject field *@
                    <div class="mb-3">
                        <label for="subject" class="form-label fw-semibold">
                            Subject <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               id="subject"
                               name="subject"
                               class="form-control"
                               placeholder="e.g. Question about my donation"
                               maxlength="200"
                               required />
                    </div>

                    @* Message field *@
                    <div class="mb-4">
                        <label for="message" class="form-label fw-semibold">
                            Message <span class="text-danger">*</span>
                        </label>
                        <textarea id="message"
                                  name="message"
                                  class="form-control"
                                  rows="6"
                                  placeholder="Describe your question or issue in detail…"
                                  maxlength="2000"
                                  required></textarea>
                        <div class="form-text">Maximum 2000 characters.</div>
                    </div>

                    @* Submit + back buttons *@
                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary-green flex-fill">
                            <i class="bi bi-send me-2"></i>Submit Query
                        </button>
                        <a href="/Query/Index" class="btn btn-outline-secondary flex-fill">
                            <i class="bi bi-arrow-left me-2"></i>Cancel
                        </a>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

