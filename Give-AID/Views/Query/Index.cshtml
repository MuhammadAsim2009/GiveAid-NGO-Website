@model IEnumerable<Give_AID.Models.Queries>
@{
    ViewData["Title"] = "My Inquiries & Support Tickets - GIVE-AID";
}

<!-- Page Header Strip -->
<section class="py-4 border-bottom bg-white">
    <div class="container">
        <div class="d-flex align-items-center gap-2 text-muted small mb-1">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a>
            <span>/</span>
            <span class="text-dark fw-semibold">Support Desk</span>
        </div>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h2 class="fw-bold mb-1" style="color: var(--primary-green); font-size: 1.6rem; letter-spacing: -0.5px;">
                    <i class="bi bi-chat-left-dots-fill me-2 text-success"></i>My Inquiries & Support Tickets
                </h2>
                <p class="text-muted small mb-0">Direct correspondence between you and the GIVE-AID administrative team.</p>
            </div>
            <a asp-action="Create" class="btn btn-donate-amber">
                <i class="bi bi-plus-circle me-1"></i>Open New Ticket
            </a>
        </div>
    </div>
</section>

<div class="container py-5">
    @if (!Model.Any())
    {
        <div class="giveaid-card p-5 text-center bg-white border">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light text-muted mb-3" style="width: 72px; height: 72px;">
                <i class="bi bi-chat-square-text fs-1 text-success"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">No Support Queries Opened</h4>
            <p class="text-muted small mb-4" style="max-width: 480px; margin: 0 auto;">
                Have questions regarding your donations, NGO allocations, or partnership verification? Our team is standing by to assist.
            </p>
            <a asp-action="Create" class="btn btn-saas-primary px-4 py-2">
                <i class="bi bi-plus-lg me-1"></i>Submit Your First Inquiry
            </a>
        </div>
    }
    else
    {
        <div class="giveaid-card p-0 bg-white border overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background: #0F172A; color: #fff;">
                        <tr>
                            <th class="px-4 py-3 font-mono" style="font-size:0.8rem;">Ticket ID</th>
                            <th class="px-4 py-3">Inquiry Topic / Subject</th>
                            <th class="px-4 py-3">Date Submitted</th>
                            <th class="px-4 py-3">Response Status</th>
                            <th class="px-4 py-3 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var query in Model)
                        {
                            <tr>
                                <td class="px-4 py-3 font-mono fw-semibold text-secondary" style="font-size:0.85rem;">
                                    #TKT-@query.Id.ToString("D4")
                                </td>
                                <td class="px-4 py-3">
                                    <div class="fw-bold text-dark">
                                        @query.Subject
                                    </div>
                                    @if (!string.IsNullOrEmpty(query.Reply))
                                    {
                                        <div class="small text-success d-flex align-items-center gap-1 mt-1">
                                            <i class="bi bi-reply-fill"></i>
                                            <span>Administrator has replied</span>
                                        </div>
                                    }
                                </td>
                                <td class="px-4 py-3 text-muted small">
                                    @query.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td class="px-4 py-3">
                                    @if (query.Status == "Resolved")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 font-mono small">
                                            <i class="bi bi-check2-all me-1"></i>Resolved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 font-mono small">
                                            <i class="bi bi-hourglass-split me-1"></i>Awaiting Response
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-end">
                                    <a asp-action="Details" asp-route-id="@query.Id" class="btn btn-sm btn-outline-secondary">
                                        View Conversation <i class="bi bi-chevron-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
