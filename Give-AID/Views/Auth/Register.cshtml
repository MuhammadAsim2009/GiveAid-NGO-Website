@model Give_AID.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register - GIVE-AID";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white text-center border-0 pt-4 pb-2">
                    <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2 mb-2">Join Our Mission</span>
                    <h3 class="fw-bold mb-1" style="color: #1E8E5A;">Create Your Donor Account</h3>
                    <p class="text-muted small">Register to support noble causes, sponsor welfare programmes, and invite friends</p>
                </div>
                <div class="card-body p-4 pt-2">
                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <h6 class="fw-bold text-uppercase small text-muted border-bottom pb-2 mb-3">1. Personal Information</h6>
                        
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-semibold small text-secondary">Full Name *</label>
                                <input asp-for="Name" class="form-control" placeholder="John Doe" autofocus />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold small text-secondary">Email Address *</label>
                                <input asp-for="Email" class="form-control" placeholder="john@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-semibold small text-secondary">Password *</label>
                                <input asp-for="Password" class="form-control" placeholder="At least 6 characters" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-secondary">Confirm Password *</label>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat your password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold small text-secondary">Phone Number</label>
                                <input asp-for="Phone" class="form-control" placeholder="+92 300 1234567" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Address" class="form-label fw-semibold small text-secondary">Residential Address</label>
                                <input asp-for="Address" class="form-control" placeholder="Street, City, Country" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>

                        <h6 class="fw-bold text-uppercase small text-muted border-bottom pb-2 mb-3">2. Professional Information</h6>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Occupation" class="form-label fw-semibold small text-secondary">Occupation / Profession</label>
                                <input asp-for="Occupation" class="form-control" placeholder="e.g. Software Engineer, Doctor, Teacher" />
                                <span asp-validation-for="Occupation" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Organization" class="form-label fw-semibold small text-secondary">Company / Organization</label>
                                <input asp-for="Organization" class="form-control" placeholder="e.g. TechCorp, Independent" />
                                <span asp-validation-for="Organization" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn text-white fw-semibold py-2" style="background-color: #1E8E5A;">
                                Complete Registration
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <p class="text-muted small mb-0">
                            Already registered? 
                            <a asp-action="Login" class="fw-semibold text-decoration-none" style="color: #1E8E5A;">Sign In here</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

