@{
    ViewData["Title"] = "Access Denied - GIVE-AID";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="giveaid-card p-5 bg-white border shadow-sm">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger mb-3" style="width: 72px; height: 72px;">
                    <i class="bi bi-shield-x fs-1"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">Access Restricted</h3>
                <p class="text-muted small mb-4" style="line-height: 1.6;">
                    You do not have the required role privileges to access the requested administrative console. If you believe this is an error, please reach out to system administrators.
                </p>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-saas-primary px-4 py-2 rounded-pill">
                        <i class="bi bi-house me-1"></i> Return to Homepage
                    </a>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                        Switch Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
