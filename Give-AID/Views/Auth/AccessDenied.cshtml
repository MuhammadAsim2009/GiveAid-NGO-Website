@{
    ViewData["Title"] = "Access Denied - GIVE-AID";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4 rounded-3">
                <div class="card-body">
                    <div class="mb-3">
                        <span class="display-3 text-danger">⚠️</span>
                    </div>
                    <h2 class="fw-bold text-danger mb-2">Access Denied</h2>
                    <p class="text-muted">You do not have administrative permissions to access this area. Please contact the administrator or return to the main portal.</p>
                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn text-white px-4 py-2 fw-semibold" style="background-color: #1E8E5A;">
                            Return to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

