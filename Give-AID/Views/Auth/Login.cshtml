@model Give_AID.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In - GIVE-AID";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <!-- SaaS Auth Card -->
            <div class="giveaid-card p-4 p-md-5 bg-white border shadow-sm">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center text-white rounded-3 shadow-sm mb-3" style="width: 48px; height: 48px; background: linear-gradient(135deg, #10B981, #047857);">
                        <i class="bi bi-shield-lock-fill fs-4"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1" style="letter-spacing: -0.5px;">Welcome Back</h3>
                    <p class="text-muted small mb-0">Sign in to manage your donor profile, track contributions, and submit inquiries.</p>
                </div>

                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3" role="alert"></div>

                    <!-- Email Input -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small text-dark">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="name@example.com" autofocus autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Password Input -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold small text-dark d-flex justify-content-between">
                            <span>Password</span>
                            <span class="text-muted fw-normal small">Confidential</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-key"></i>
                            </span>
                            <input asp-for="Password" id="passwordField" class="form-control border-start-0 border-end-0 ps-0" placeholder="••••••••" autocomplete="current-password" />
                            <button class="btn btn-outline-light border border-start-0 text-muted" type="button" id="togglePasswordBtn">
                                <i class="bi bi-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-saas-primary w-100 fw-bold py-2 shadow-sm mt-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Account
                    </button>
                </form>

                <!-- Demo Access Helper Box -->
                <div class="p-3 rounded-3 border bg-light mt-4 small">
                    <div class="fw-semibold text-dark mb-1 d-flex align-items-center gap-1">
                        <i class="bi bi-info-circle text-primary"></i> Default System Administrator
                    </div>
                    <div class="d-flex justify-content-between align-items-center font-mono text-muted" style="font-size: 0.8rem;">
                        <span>admin@giveaid.org</span>
                        <span>Admin@123</span>
                    </div>
                </div>

                <div class="text-center mt-4 pt-3 border-top">
                    <p class="text-muted small mb-0">
                        New to GIVE-AID?
                        <a asp-action="Register" class="fw-bold text-decoration-none" style="color: var(--primary-green);">Create an Account</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const toggleBtn = document.getElementById("togglePasswordBtn");
        const passwordField = document.getElementById("passwordField");
        const toggleIcon = document.getElementById("toggleIcon");

        if (toggleBtn && passwordField) {
            toggleBtn.addEventListener("click", function () {
                const isPassword = passwordField.type === "password";
                passwordField.type = isPassword ? "text" : "password";
                toggleIcon.className = isPassword ? "bi bi-eye-slash" : "bi bi-eye";
            });
        }
    </script>
}
