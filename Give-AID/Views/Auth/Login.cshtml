@model Give_AID.Models.LoginViewModel
@{
    ViewData["Title"] = "Login - GIVE-AID";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white text-center border-0 pt-4 pb-2">
                    <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2 mb-2">Welcome Back</span>
                    <h3 class="fw-bold mb-1" style="color: #1E8E5A;">Sign In to GIVE-AID</h3>
                    <p class="text-muted small">Access your donor dashboard, track donations, and help NGOs</p>
                </div>
                <div class="card-body p-4 pt-2">
                    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold small text-secondary">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i>@@</span>
                                <input asp-for="Email" class="form-control border-start-0" placeholder="name@example.com" autofocus />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold small text-secondary">Password</label>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn text-white fw-semibold py-2" style="background-color: #1E8E5A;">
                                Sign In
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <p class="text-muted small mb-0">
                            Don't have an account yet? 
                            <a asp-action="Register" class="fw-semibold text-decoration-none" style="color: #1E8E5A;">Register here</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

