@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GIVE-AID</title>
    <!-- Google Fonts: Poppins & Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: #1E293B;
            background-color: #F8FAFC;
        }
        h1, h2, h3, h4, h5, h6, .giveaid-brand {
            font-family: 'Poppins', sans-serif;
        }
        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }
        .saas-navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid #E2E8F0;
            position: sticky;
            top: 0;
            z-index: 1030;
            transition: all 0.2s ease-in-out;
        }
        .saas-navbar .nav-link {
            font-weight: 500;
            color: #475569;
            padding: 0.5rem 0.85rem;
            border-radius: 0.5rem;
            transition: all 0.15s ease-in-out;
        }
        .saas-navbar .nav-link:hover, .saas-navbar .nav-link.active {
            color: #059669;
            background: #F0FDF4;
        }
        .saas-topbar {
            background: #0F172A;
            color: #94A3B8;
            font-size: 0.8rem;
            padding: 0.35rem 0;
            border-bottom: 1px solid #1E293B;
        }
        .saas-topbar a {
            color: #CBD5E1;
            text-decoration: none;
        }
        .saas-topbar a:hover {
            color: #34D399;
        }
        .saas-footer {
            background: #0F172A;
            color: #94A3B8;
            padding-top: 4rem;
            padding-bottom: 2rem;
            border-top: 1px solid #1E293B;
        }
        .saas-footer h5, .saas-footer h6 {
            color: #F8FAFC;
            font-weight: 600;
        }
        .saas-footer a {
            color: #94A3B8;
            text-decoration: none;
            transition: color 0.15s ease-in-out;
        }
        .saas-footer a:hover {
            color: #34D399;
        }
    </style>
</head>
<body>
    <!-- Top Information Banner -->
    <div class="saas-topbar d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <span><i class="bi bi-geo-alt text-success me-1"></i>Main Welfare Secretariat, Karachi, Pakistan</span>
                <span>•</span>
                <span><i class="bi bi-envelope text-success me-1"></i>contact@giveaid.org</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span><i class="bi bi-telephone text-success me-1"></i>+92 300 1234567</span>
                <span class="badge bg-emerald-subtle text-success border border-success-subtle font-mono" style="font-size:0.7rem;">
                    <i class="bi bi-patch-check-fill me-1"></i>Certified Welfare Portal
                </span>
            </div>
        </div>
    </div>

    <!-- Main Responsive Navigation Bar -->
    <nav class="navbar navbar-expand-lg saas-navbar">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-controller="Home" asp-action="Index" style="color: #0F172A; font-size: 1.35rem; letter-spacing: -0.5px;">
                <div class="d-flex align-items-center justify-content-center text-white rounded-3 shadow-sm" style="width: 38px; height: 38px; background: linear-gradient(135deg, #10B981 0%, #047857 100%);">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>
                <span>GIVE<span style="color: #059669;">-AID</span></span>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <!-- Left Nav Links -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                            Home
                        </a>
                    </li>

                    <!-- About Us Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            About Us
                        </a>
                        <ul class="dropdown-menu shadow-lg border-0 rounded-3 mt-2" style="min-width: 230px;">
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="About" asp-route-slug="what-we-do"><i class="bi bi-info-circle me-2 text-success"></i>What We Do</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="About" asp-route-slug="our-mission"><i class="bi bi-bullseye me-2 text-success"></i>Our Mission</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="About" asp-route-slug="our-team"><i class="bi bi-people me-2 text-success"></i>Our Team</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="About" asp-route-slug="career-with-us"><i class="bi bi-briefcase me-2 text-success"></i>Career With Us</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="About" asp-route-slug="our-achievements"><i class="bi bi-trophy me-2 text-success"></i>Our Achievements</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="About" asp-route-slug="our-supporters"><i class="bi bi-award me-2 text-success"></i>Our Supporters</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="About" asp-route-slug="read-about-us"><i class="bi bi-newspaper me-2 text-success"></i>Read About Us</a></li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Programmes" ? "active" : "")" asp-controller="Home" asp-action="Programmes">
                            Programmes
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Ngos" ? "active" : "")" asp-controller="Home" asp-action="Ngos">
                            NGO Partners
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Partners" ? "active" : "")" asp-controller="Home" asp-action="Partners">
                            Sponsors
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Gallery" ? "active" : "")" asp-controller="Home" asp-action="Gallery">
                            Gallery
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "HelpCentre" ? "active" : "")" asp-controller="Home" asp-action="HelpCentre">
                            Help Centre
                        </a>
                    </li>
                </ul>

                <!-- Right Nav Links & Account / Auth Session -->
                <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                    @{
                        int? userId = Context.Session.GetInt32("UserId");
                        string? userName = Context.Session.GetString("UserName");
                        string? userRole = Context.Session.GetString("UserRole");
                    }

                    @if (userId != null)
                    {
                        @if (userRole == "Admin")
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-dark btn-sm fw-semibold px-3" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock-fill me-1 text-warning"></i>Admin Console
                                </a>
                            </li>
                        }

                        <!-- User Profile Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fw-semibold d-flex align-items-center gap-2 bg-light border px-3 py-1 rounded-pill" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center small" style="width: 24px; height: 24px; font-size: 0.75rem;">
                                    @((userName ?? "U").Substring(0, 1).ToUpper())
                                </div>
                                <span class="small text-dark">@userName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2" style="min-width: 220px;">
                                <li class="dropdown-header text-muted small">Account Type: <strong class="text-success">@userRole</strong></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2" asp-controller="Donation" asp-action="History"><i class="bi bi-clock-history me-2 text-primary"></i>My Donations</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Query" asp-action="Index"><i class="bi bi-chat-left-dots me-2 text-info"></i>My Queries</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Programme" asp-action="MyInterests"><i class="bi bi-star me-2 text-warning"></i>Programme Interests</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Invite" asp-action="Index"><i class="bi bi-person-plus me-2 text-success"></i>Invite Friends</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 text-danger" asp-controller="Auth" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Auth" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-success btn-sm px-3 fw-semibold rounded-pill" asp-controller="Auth" asp-action="Register">
                                Join as Donor
                            </a>
                        </li>
                    }

                    <!-- Primary Amber CTA: Donate Now -->
                    <li class="nav-item">
                        <a class="btn btn-donate-amber shadow-sm d-flex align-items-center px-3 py-2 rounded-pill fw-bold" asp-controller="Donation" asp-action="Create">
                            <i class="bi bi-heart-fill me-1 text-danger"></i>Donate Now
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content Area with Dismissible Alerts -->
    <main role="main">
        <div class="container mt-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>

        @RenderBody()
    </main>

    <!-- Comprehensive SaaS Footer -->
    <footer class="saas-footer mt-5">
        <div class="container">
            <div class="row g-4">
                <!-- Col 1: Brand & Mission -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="d-flex align-items-center justify-content-center text-white rounded-3" style="width: 36px; height: 36px; background: linear-gradient(135deg, #10B981, #047857);">
                            <i class="bi bi-heart-pulse-fill"></i>
                        </div>
                        <h4 class="text-white mb-0 fw-bold">GIVE-AID</h4>
                    </div>
                    <p class="small text-muted mb-4" style="line-height: 1.7;">
                        GIVE-AID is an accountable welfare platform connecting donors with certified non-profits to fund healthcare, education, clean water, and emergency relief programs.
                    </p>
                    <div class="d-flex gap-3 fs-5">
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-twitter-x"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <!-- Col 2: Navigation Links -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="text-uppercase small fw-bold mb-3" style="letter-spacing: 0.5px;">Platform</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><a asp-controller="Home" asp-action="Index">Home Overview</a></li>
                        <li><a asp-controller="Home" asp-action="Programmes">Field Campaigns</a></li>
                        <li><a asp-controller="Home" asp-action="Ngos">Partner Charities</a></li>
                        <li><a asp-controller="Home" asp-action="Partners">Corporate Sponsors</a></li>
                        <li><a asp-controller="Home" asp-action="Gallery">Photo Gallery</a></li>
                        <li><a asp-controller="Donation" asp-action="Create">Make a Donation</a></li>
                    </ul>
                </div>

                <!-- Col 3: About & Transparency -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="text-uppercase small fw-bold mb-3" style="letter-spacing: 0.5px;">About GIVE-AID</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><a asp-controller="Home" asp-action="About" asp-route-slug="what-we-do">What We Do</a></li>
                        <li><a asp-controller="Home" asp-action="About" asp-route-slug="our-mission">Our Mission & Vision</a></li>
                        <li><a asp-controller="Home" asp-action="About" asp-route-slug="our-team">Leadership Team</a></li>
                        <li><a asp-controller="Home" asp-action="About" asp-route-slug="our-achievements">Track Record</a></li>
                        <li><a asp-controller="Home" asp-action="About" asp-route-slug="career-with-us">Careers & Volunteering</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                    </ul>
                </div>

                <!-- Col 4: Support & Security Assurance -->
                <div class="col-lg-4 col-md-6">
                    <h6 class="text-uppercase small fw-bold mb-3" style="letter-spacing: 0.5px;">Support & Contact</h6>
                    <p class="small text-muted mb-3">
                        Have inquiries regarding allocations or tax deductibility? Our secretariat support team is here to help.
                    </p>
                    <div class="p-3 rounded-3 bg-dark border border-secondary mb-3 small">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-clock text-success"></i>
                            <span class="text-white">Desk Hours: Mon – Sat, 9:00 AM – 6:00 PM</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-shield-check text-success"></i>
                            <span class="text-white-50">100% Directed Philanthropy Guarantee</span>
                        </div>
                    </div>
                    <a asp-controller="Home" asp-action="HelpCentre" class="btn btn-outline-light btn-sm w-100">
                        <i class="bi bi-question-circle me-1"></i>Visit Help Centre & FAQs
                    </a>
                </div>
            </div>

            <div class="pt-4 mt-5 border-top border-secondary d-flex justify-content-between align-items-center flex-wrap gap-2 small text-muted">
                <div>
                    &copy; @DateTime.UtcNow.Year GIVE-AID Welfare Foundation. All rights reserved.
                </div>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                    <a asp-controller="Home" asp-action="HelpCentre">Security Compliance</a>
                    <a asp-controller="Home" asp-action="Contact">Secretariat Direct</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JavaScript Bundle -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
