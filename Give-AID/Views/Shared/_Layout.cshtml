@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GIVE-AID</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Information Banner -->
    <div class="py-1 px-3 small border-bottom bg-white d-none d-md-block text-muted">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <span class="me-3"><i class="bi bi-geo-alt text-success me-1"></i>Main Welfare Secretariat, Karachi, Pakistan</span>
                <span><i class="bi bi-envelope text-success me-1"></i>contact@giveaid.org</span>
            </div>
            <div>
                <span class="me-3"><i class="bi bi-telephone text-success me-1"></i>+92 300 1234567</span>
                <span class="badge bg-success-subtle text-success">Certified Non-Profit</span>
            </div>
        </div>
    </div>

    <!-- Main Responsive Navigation Bar -->
    <nav class="navbar navbar-expand-lg giveaid-navbar">
        <div class="container">
            <a class="navbar-brand giveaid-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-heart-pulse-fill text-danger"></i> GIVE-AID
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <!-- Left Nav Links -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link giveaid-nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house me-1"></i>Home
                        </a>
                    </li>

                    <!-- About Us Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link giveaid-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            About Us
                        </a>
                        <ul class="dropdown-menu shadow-sm border-0 rounded-3">
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="About" asp-route-slug="what-we-do"><i class="bi bi-info-circle me-2 text-success"></i>What We Do</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="About" asp-route-slug="our-mission"><i class="bi bi-bullseye me-2 text-success"></i>Our Mission</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="About" asp-route-slug="our-team"><i class="bi bi-people me-2 text-success"></i>Our Team</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="About" asp-route-slug="career-with-us"><i class="bi bi-briefcase me-2 text-success"></i>Career With Us</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="About" asp-route-slug="our-achievements"><i class="bi bi-trophy me-2 text-success"></i>Our Achievements</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="About" asp-route-slug="our-supporters"><i class="bi bi-award me-2 text-success"></i>Our Supporters</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="About" asp-route-slug="read-about-us"><i class="bi bi-newspaper me-2 text-success"></i>Read About Us</a></li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link giveaid-nav-link" asp-controller="Home" asp-action="Programmes">
                            Programmes
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link giveaid-nav-link" asp-controller="Home" asp-action="Partners">
                            Our Partners
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link giveaid-nav-link" asp-controller="Home" asp-action="HelpCentre">
                            Help Centre
                        </a>
                    </li>
                </ul>

                <!-- Right Nav Links & Account / Auth Session -->
                <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                    @{
                        int? userId = Context.Session.GetInt32("UserId");
                        string? userName = Context.Session.GetString("UserName");
                        string? userRole = Context.Session.GetString("UserRole");
                    }

                    @if (userId != null)
                    {
                        @if (userRole == "Admin")
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-dark btn-sm fw-semibold" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock-fill me-1 text-warning"></i>Admin Portal
                                </a>
                            </li>
                        }

                        <!-- User Profile Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link giveaid-nav-link dropdown-toggle fw-semibold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle text-success me-1"></i>@userName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                <li class="dropdown-header text-muted small">Signed in as <strong>@userRole</strong></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2" asp-controller="Donation" asp-action="History"><i class="bi bi-clock-history me-2 text-primary"></i>My Donations</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Query" asp-action="Index"><i class="bi bi-chat-left-dots me-2 text-info"></i>My Queries</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Programme" asp-action="MyInterests"><i class="bi bi-star me-2 text-warning"></i>Programme Interests</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Invite" asp-action="Index"><i class="bi bi-person-plus me-2 text-success"></i>Invite Friends</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 text-danger" asp-controller="Auth" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link giveaid-nav-link" asp-controller="Auth" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-green btn-sm" asp-controller="Auth" asp-action="Register">
                                Register
                            </a>
                        </li>
                    }

                    <!-- Primary Amber CTA: Donate Now -->
                    <li class="nav-item">
                        <a class="btn btn-donate-amber shadow-sm d-flex align-items-center" asp-controller="Donation" asp-action="Create">
                            <i class="bi bi-heart-fill me-1"></i>Donate Now
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content Area with Dismissible Alerts -->
    <main role="main">
        <div class="container mt-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>

        @RenderBody()
    </main>

    <!-- Comprehensive Footer Following Design Specification -->
    <footer class="giveaid-footer">
        <div class="container">
            <div class="row g-4">
                <!-- Col 1: About GIVE-AID -->
                <div class="col-lg-4 col-md-6">
                    <h5 class="d-flex align-items-center gap-2">
                        <i class="bi bi-heart-pulse-fill text-danger"></i> GIVE-AID
                    </h5>
                    <p class="small text-muted mb-3">
                        GIVE-AID is a transparent donation platform empowering partner NGOs to deliver education, healthcare, nutrition, and relief to underprivileged communities.
                    </p>
                    <div class="d-flex gap-3 fs-5">
                        <a href="#" class="text-secondary"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-secondary"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="text-secondary"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-secondary"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <!-- Col 2: Quick Links -->
                <div class="col-lg-2 col-md-6">
                    <h5>Quick Links</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="About" asp-route-slug="what-we-do">About Us</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Programmes">Programmes</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Partners">Our Partners</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Gallery">Photo Gallery</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="HelpCentre">Help Centre</a></li>
                    </ul>
                </div>

                <!-- Col 3: Causes Supported -->
                <div class="col-lg-3 col-md-6">
                    <h5>Noble Causes</h5>
                    <ul class="list-unstyled small text-muted">
                        <li class="mb-2"><i class="bi bi-check2 text-success me-1"></i>Child Welfare & Nutrition</li>
                        <li class="mb-2"><i class="bi bi-check2 text-success me-1"></i>Quality Education For All</li>
                        <li class="mb-2"><i class="bi bi-check2 text-success me-1"></i>Healthcare & Medical Camps</li>
                        <li class="mb-2"><i class="bi bi-check2 text-success me-1"></i>Specially Challenged Support</li>
                        <li class="mb-2"><i class="bi bi-check2 text-success me-1"></i>Women Empowerment</li>
                        <li class="mb-2"><i class="bi bi-check2 text-success me-1"></i>Elderly Dignified Care</li>
                    </ul>
                </div>

                <!-- Col 4: Contact Information -->
                <div class="col-lg-3 col-md-6">
                    <h5>Contact Us</h5>
                    <ul class="list-unstyled small text-muted">
                        <li class="mb-2"><i class="bi bi-geo-alt me-2 text-success"></i>Plot 45-C, Main Commercial Avenue, Karachi, Pakistan</li>
                        <li class="mb-2"><i class="bi bi-envelope me-2 text-success"></i>support@giveaid.org</li>
                        <li class="mb-2"><i class="bi bi-telephone me-2 text-success"></i>+92 300 1234567</li>
                        <li class="mb-2"><i class="bi bi-clock me-2 text-success"></i>Mon - Sat: 9:00 AM - 6:00 PM</li>
                    </ul>
                </div>
            </div>

            <!-- Bottom Bar -->
            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center small text-muted">
                <div>
                    &copy; 2026 GIVE-AID Welfare Foundation. All rights reserved.
                </div>
                <div class="mt-2 mt-md-0">
                    <a asp-controller="Home" asp-action="Privacy" class="me-3">Privacy Policy</a>
                    <a asp-controller="Home" asp-action="HelpCentre">Help & FAQs</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
