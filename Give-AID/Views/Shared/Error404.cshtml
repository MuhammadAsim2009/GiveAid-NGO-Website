@* Shared/Error404 — friendly 404 not-found page *@
@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container py-5 text-center">

    @* Large 404 icon *@
    <div style="font-size:6rem; color:#1E8E5A; line-height:1;">
        <i class="bi bi-signpost-split"></i>
    </div>

    @* Error code *@
    <h1 class="display-1 fw-bold mt-3" style="color:#1E8E5A;">404</h1>

    <h4 class="fw-semibold mb-3">Oops! Page Not Found</h4>
    <p class="text-muted mb-4" style="max-width:500px; margin:auto;">
        The page you are looking for may have been moved, deleted, or never existed.
        Don't worry — there is still a lot of good you can do!
    </p>

    @* Navigation buttons *@
    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a href="/" class="btn btn-primary-green btn-lg px-5">
            <i class="bi bi-house me-2"></i>Go Home
        </a>
        <a href="/Donation/Create" class="btn btn-donate-amber btn-lg px-5">
            <i class="bi bi-heart-fill me-2"></i>Donate Now
        </a>
    </div>

    @* Quick links *@
    <div class="mt-5">
        <p class="text-muted small mb-2">Or explore:</p>
        <a href="/Home/Programmes" class="text-decoration-none me-3" style="color:#1E8E5A;">Programmes</a>
        <a href="/Home/Partners" class="text-decoration-none me-3" style="color:#1E8E5A;">Partners</a>
        <a href="/Home/HelpCentre" class="text-decoration-none me-3" style="color:#1E8E5A;">Help Centre</a>
        <a href="/Home/Contact" class="text-decoration-none" style="color:#1E8E5A;">Contact Us</a>
    </div>

</div>

