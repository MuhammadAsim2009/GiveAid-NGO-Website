@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GIVE-AID Admin</title>
    <!-- Google Fonts: Poppins & Open Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="saas-admin-body">
    <div class="container-fluid p-0">
        <div class="d-flex flex-column flex-md-row min-vh-100">

            <!-- ── Sidebar ────────────────────────────────────────────────── -->
            <aside id="adminSidebar" class="col-md-3 col-lg-2 saas-sidebar collapse d-md-flex flex-column">
                
                <!-- Brand / Logo Header -->
                <a class="saas-sidebar-brand" asp-controller="Admin" asp-action="Index">
                    <div class="saas-brand-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="saas-brand-title">GIVE-AID</span>
                        </div>
                        <span class="small text-white" style="font-size: 0.7rem;">Welfare Admin Console</span>
                    </div>
                </a>

                <!-- Navigation List -->
                <div class="saas-sidebar-nav overflow-y-auto">
                    
                    <!-- Section: Core -->
                    <div class="saas-nav-section-title">Overview</div>
                    <a class="saas-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>

                    <!-- Section: Financial & Impact -->
                    <div class="saas-nav-section-title">Finance & Impact</div>
                    <a class="saas-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Donations" ? "active" : "")" asp-controller="Admin" asp-action="Donations">
                        <i class="bi bi-cash-stack"></i>
                        <span>Donations</span>
                    </a>
                    <a class="saas-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "PaymentSettings" ? "active" : "")" asp-controller="Admin" asp-action="PaymentSettings">
                        <i class="bi bi-credit-card-2-front-fill"></i>
                        <span>Payment Channels</span>
                    </a>
                    <a class="saas-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Causes" ? "active" : "")" asp-controller="Admin" asp-action="Causes">
                        <i class="bi bi-bookmark-heart-fill"></i>
                        <span>Causes</span>
                    </a>

                    <!-- Section: Network & Operations -->
                    <div class="saas-nav-section-title">Network & Operations</div>
                    <a class="saas-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Ngos" ? "active" : "")" asp-controller="Admin" asp-action="Ngos">
                        <i class="bi bi-building"></i>
                        <span>NGO Partners</span>
                    </a>
                    <a class="saas-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Programmes" ? "active" : "")" asp-controller="Admin" asp-action="Programmes">
                        <i class="bi bi-calendar2-week-fill"></i>
                        <span>Programmes</span>
                    </a>
                    <a class="saas-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Partners" ? "active" : "")" asp-controller="Admin" asp-action="Partners">
                        <i class="bi bi-award-fill"></i>
                        <span>Corporate Sponsors</span>
                    </a>

                    <!-- Section: Community & Inquiries -->
                    <div class="saas-nav-section-title">Community & Support</div>
                    <a class="saas-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Members" ? "active" : "")" asp-controller="Admin" asp-action="Members">
                        <i class="bi bi-people-fill"></i>
                        <span>Members</span>
                    </a>
                    <a class="saas-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Queries" ? "active" : "")" asp-controller="Admin" asp-action="Queries">
                        <i class="bi bi-chat-left-dots-fill"></i>
                        <span>User Queries</span>
                    </a>
                    <a class="saas-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Interests" ? "active" : "")" asp-controller="Admin" asp-action="Interests">
                        <i class="bi bi-star-fill"></i>
                        <span>Interests</span>
                    </a>

                    <!-- Section: Media & Content -->
                    <div class="saas-nav-section-title">Content & Media</div>
                    <a class="saas-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Gallery" ? "active" : "")" asp-controller="Admin" asp-action="Gallery">
                        <i class="bi bi-images"></i>
                        <span>Media Gallery</span>
                    </a>
                    <a class="saas-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Pages" ? "active" : "")" asp-controller="Admin" asp-action="Pages">
                        <i class="bi bi-file-earmark-richtext-fill"></i>
                        <span>CMS Pages</span>
                    </a>
                </div>

                <!-- Bottom User Box -->
                <div class="saas-sidebar-footer">
                    <div class="saas-user-box justify-content-between">
                        <div class="d-flex align-items-center gap-2 overflow-hidden">
                            <div class="saas-avatar-initials">
                                @(Context.Session.GetString("UserName")?.Substring(0, 1).ToUpper() ?? "A")
                            </div>
                            <div class="saas-user-info">
                                <div class="saas-user-name">@(Context.Session.GetString("UserName") ?? "Administrator")</div>
                                <div class="saas-user-role">Super Admin</div>
                            </div>
                        </div>
                        <a asp-controller="Auth" asp-action="Logout" class="text-danger fs-5 p-1" title="Sign Out">
                            <i class="bi bi-box-arrow-right"></i>
                        </a>
                    </div>
                </div>

            </aside>

            <!-- ── Main Content Container ────────────────────────────────────── -->
            <div class="col-md-9 col-lg-10 d-flex flex-column flex-grow-1">
                
                <!-- Top Header Bar -->
                <header class="saas-topbar d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-sm btn-outline-secondary d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#adminSidebar">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <div class="saas-breadcrumb d-none d-sm-flex align-items-center gap-2">
                            <a asp-controller="Admin" asp-action="Index"><i class="bi bi-house-door"></i> Admin</a>
                            <span class="text-muted">/</span>
                            <span class="fw-semibold text-dark">@ViewData["Title"]</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <div class="saas-status-indicator d-none d-md-inline-flex">
                            <span class="saas-status-dot"></span> Live Production
                        </div>
                        <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-sm btn-saas-secondary">
                            <i class="bi bi-box-arrow-up-right"></i>
                            <span class="d-none d-sm-inline">Public Portal</span>
                        </a>
                    </div>
                </header>

                <!-- Page Content Body -->
                <main class="p-3 p-md-4 flex-grow-1">
                    @* Toast Alerts *@
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4 border-0" style="background:#ECFDF5; color:#065F46; border-left: 4px solid #10B981 !important;" role="alert">
                            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
                            <span>@TempData["SuccessMessage"]</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4 border-0" style="background:#FFF1F2; color:#9F1239; border-left: 4px solid #F43F5E !important;" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i>
                            <span>@TempData["ErrorMessage"]</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </main>
            </div>

        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
