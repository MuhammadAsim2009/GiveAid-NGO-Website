@model IEnumerable<Give_AID.Models.PageContents>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "CMS Pages";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="font-size: 1.5rem; letter-spacing: -0.5px;">CMS & Static Pages</h2>
        <p class="text-muted small mb-0">Manage content copy for public sections including About Us sub-pages and Help Centre guidelines.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-white border text-dark px-3 py-2 fw-semibold">
            <i class="bi bi-file-earmark-text text-primary me-1"></i> Total Articles: @(Model?.Count() ?? 0)
        </span>
    </div>
</div>

<!-- SaaS Table Card -->
<div class="saas-card">
    <div class="saas-card-header">
        <div class="saas-card-title">
            <i class="bi bi-file-earmark-richtext text-primary"></i>
            <span>Published Information Articles</span>
        </div>
        <div class="saas-table-search">
            <i class="bi bi-search"></i>
            <input type="text" id="pageSearchInput" class="form-control form-control-sm" placeholder="Search pages..." onkeyup="filterPageTable()" />
        </div>
    </div>
    <div class="p-0">
        <div class="table-responsive">
            <table class="saas-table align-middle" id="pageTable">
                <thead>
                    <tr>
                        <th>Page Title</th>
                        <th>URL Slug / Route</th>
                        <th>Content Excerpt</th>
                        <th>Last Modified</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var pageItem in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark" style="font-size: 0.95rem;">@pageItem.Title</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark font-mono border">
                                        /About/@pageItem.Slug
                                    </span>
                                </td>
                                <td>
                                    <div class="text-muted small text-truncate" style="max-width: 380px;">@pageItem.Body</div>
                                </td>
                                <td>
                                    <span class="text-muted small">@pageItem.UpdatedAt.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="EditPage" asp-route-id="@pageItem.Id" class="btn btn-sm btn-saas-secondary">
                                        <i class="bi bi-pencil me-1"></i> Edit Copy
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 text-muted d-block mb-2"></i>
                                No CMS pages found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function filterPageTable() {
        const input = document.getElementById("pageSearchInput").value.toLowerCase();
        const rows = document.querySelectorAll("#pageTable tbody tr");
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = text.includes(input) ? "" : "none";
        });
    }
</script>
}
