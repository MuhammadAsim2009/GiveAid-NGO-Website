@model IEnumerable<Give_AID.Models.PageContents>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Content Pages";
}

<div class="pt-3 pb-2 mb-3 border-bottom">
    <h2 class="fw-bold text-dark mb-0">Website Content Pages</h2>
    <p class="text-muted small mb-0">Update text and information for static pages (About Us sub-pages, Help Centre)</p>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th>Page Title</th>
                        <th>URL Slug</th>
                        <th>Content Preview</th>
                        <th>Last Updated</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var pageItem in Model)
                        {
                            <tr>
                                <td class="fw-bold">@pageItem.Title</td>
                                <td><span class="badge bg-light text-dark font-monospace border">@pageItem.Slug</span></td>
                                <td class="small text-muted text-truncate" style="max-width: 320px;">@pageItem.Body</td>
                                <td class="small text-muted">@pageItem.UpdatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="EditPage" asp-route-id="@pageItem.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil me-1"></i>Edit Content
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No CMS pages found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

