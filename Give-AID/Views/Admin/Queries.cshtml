@model IEnumerable<Give_AID.Models.Queries>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Support Inquiries";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="font-size: 1.5rem; letter-spacing: -0.5px;">User Inquiries & Helpdesk</h2>
        <p class="text-muted small mb-0">Triage incoming member questions, track support status, and dispatch official replies.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-white border text-dark px-3 py-2 fw-semibold">
            <i class="bi bi-chat-left-dots text-warning me-1"></i> Total Inquiries: @(Model?.Count() ?? 0)
        </span>
    </div>
</div>

<!-- Support Tickets Card Accordion -->
<div class="saas-card mb-4">
    <div class="saas-card-header">
        <div class="saas-card-title">
            <i class="bi bi-inbox text-warning"></i>
            <span>Active Ticket Queue</span>
        </div>
        <div class="saas-table-search">
            <i class="bi bi-search"></i>
            <input type="text" id="querySearchInput" class="form-control form-control-sm" placeholder="Filter tickets..." onkeyup="filterQueries()" />
        </div>
    </div>
    <div class="p-0">
        @if (Model != null && Model.Any())
        {
            <div class="accordion accordion-flush" id="queriesAccordion">
                @foreach (var query in Model)
                {
                    string collapseId = $"query-{query.Id}";
                    bool isOpen = query.Status == "Open";
                    <div class="accordion-item query-ticket-item border-bottom">
                        <h2 class="accordion-header">
                            <button class="accordion-button @(isOpen ? "" : "collapsed") py-3 px-4" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(isOpen ? "true" : "false")">
                                <div class="d-flex align-items-center w-100 me-3 gap-3 flex-wrap">
                                    @if (query.Status == "Open")
                                    {
                                        <span class="badge-status badge-status-warning">Open</span>
                                    }
                                    else if (query.Status == "In Progress")
                                    {
                                        <span class="badge-status badge-status-info">In Progress</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-status-success">Resolved</span>
                                    }

                                    <div class="fw-bold text-dark flex-grow-1 query-ticket-subject" style="font-size: 0.95rem;">
                                        @query.Subject
                                    </div>

                                    <div class="small text-muted query-ticket-author">
                                        <i class="bi bi-person me-1"></i>@(query.User?.Name ?? "Member") &bull; @query.CreatedAt.ToString("MMM dd, yyyy")
                                    </div>
                                </div>
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse @(isOpen ? "show" : "")" data-bs-parent="#queriesAccordion">
                            <div class="accordion-body p-4" style="background: #F8FAFC;">
                                <!-- Member Inquired Text -->
                                <div class="saas-card p-3 mb-3 border">
                                    <div class="d-flex align-items-center gap-2 mb-2 text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">
                                        <i class="bi bi-chat-quote-fill text-primary"></i> Member Inquiry
                                    </div>
                                    <p class="mb-0 text-dark" style="white-space: pre-line;">@query.Message</p>
                                </div>

                                <!-- Current Admin Response -->
                                @if (!string.IsNullOrEmpty(query.Reply))
                                {
                                    <div class="saas-card p-3 mb-3 border-0 border-start border-4 border-success" style="background: #ECFDF5;">
                                        <div class="d-flex align-items-center gap-2 mb-1 text-success small fw-bold text-uppercase">
                                            <i class="bi bi-shield-check"></i> Official Administrator Response
                                        </div>
                                        <p class="mb-0 text-dark" style="white-space: pre-line;">@query.Reply</p>
                                    </div>
                                }

                                <!-- Reply Form -->
                                <div class="saas-card p-3 border">
                                    <form asp-action="ReplyQuery" asp-route-id="@query.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <label class="form-label fw-semibold small text-dark mb-2">Compose Response</label>
                                        <textarea name="reply" class="form-control mb-3" rows="3" placeholder="Provide a helpful, professional solution or clarification...">@query.Reply</textarea>

                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <select name="status" class="form-select form-select-sm" style="max-width: 170px;">
                                                @if (query.Status == "Open")
                                                {
                                                    <option value="Open" selected>Open</option>
                                                    <option value="In Progress">In Progress</option>
                                                    <option value="Resolved">Resolved</option>
                                                }
                                                else if (query.Status == "In Progress")
                                                {
                                                    <option value="Open">Open</option>
                                                    <option value="In Progress" selected>In Progress</option>
                                                    <option value="Resolved">Resolved</option>
                                                }
                                                else
                                                {
                                                    <option value="Open">Open</option>
                                                    <option value="In Progress">In Progress</option>
                                                    <option value="Resolved" selected>Resolved</option>
                                                }
                                            </select>

                                            <button type="submit" class="btn btn-saas-primary">
                                                <i class="bi bi-send-fill"></i> Save & Send Reply
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-chat-square-check fs-2 text-success d-block mb-2"></i>
                <p class="mb-0 fw-semibold">No inquiries submitted yet.</p>
                <span class="small text-muted">Member support messages will appear here in real time.</span>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    function filterQueries() {
        const input = document.getElementById("querySearchInput").value.toLowerCase();
        const items = document.querySelectorAll(".query-ticket-item");
        items.forEach(item => {
            const text = item.innerText.toLowerCase();
            item.style.display = text.includes(input) ? "" : "none";
        });
    }
</script>
}
