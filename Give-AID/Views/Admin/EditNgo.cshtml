@model Give_AID.Models.Ngos
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit NGO";
}

<div class="pt-3 pb-2 mb-3 border-bottom">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small mb-1">
            <li class="breadcrumb-item"><a asp-action="Ngos" class="text-success text-decoration-none">NGOs</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </ol>
    </nav>
    <h2 class="fw-bold text-dark mb-0">Edit NGO Partner</h2>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
            <form asp-action="EditNgo" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small text-secondary">Organization Name *</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold small text-secondary">Overview & Mission *</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Contact" class="form-label fw-semibold small text-secondary">Contact Details & Location *</label>
                    <input asp-for="Contact" class="form-control" />
                    <span asp-validation-for="Contact" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Logo" class="form-label fw-semibold small text-secondary">Logo Path</label>
                    <input asp-for="Logo" class="form-control" />
                    <span asp-validation-for="Logo" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary-green px-4 fw-semibold">
                        <i class="bi bi-check-lg me-1"></i>Update NGO
                    </button>
                    <a asp-action="Ngos" class="btn btn-outline-secondary px-3">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

