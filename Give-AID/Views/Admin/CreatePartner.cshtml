@model Give_AID.Models.Partners
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Corporate Partner";
}

<div class="pt-3 pb-2 mb-3 border-bottom">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small mb-1">
            <li class="breadcrumb-item"><a asp-action="Partners" class="text-success text-decoration-none">Partners</a></li>
            <li class="breadcrumb-item active" aria-current="page">Add</li>
        </ol>
    </nav>
    <h2 class="fw-bold text-dark mb-0">Add Corporate Partner</h2>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
            <form asp-action="CreatePartner" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small text-secondary">Partner Organization Name *</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Apex Pharma, Global Care" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LogoPath" class="form-label fw-semibold small text-secondary">Logo Image Path *</label>
                    <input asp-for="LogoPath" class="form-control" placeholder="/images/logos/partner-logo.png" />
                    <span asp-validation-for="LogoPath" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Website" class="form-label fw-semibold small text-secondary">Website URL</label>
                    <input asp-for="Website" class="form-control" placeholder="https://example.com" />
                    <span asp-validation-for="Website" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary-green px-4 fw-semibold">
                        <i class="bi bi-check-lg me-1"></i>Save Partner
                    </button>
                    <a asp-action="Partners" class="btn btn-outline-secondary px-3">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

