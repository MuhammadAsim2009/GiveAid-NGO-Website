@model Give_AID.Models.Causes
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create Cause";
}

<div class="pt-3 pb-2 mb-3 border-bottom">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small mb-1">
            <li class="breadcrumb-item"><a asp-action="Causes" class="text-success text-decoration-none">Causes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Create</li>
        </ol>
    </nav>
    <h2 class="fw-bold text-dark mb-0">Add New Cause</h2>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
            <form asp-action="CreateCause" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small text-secondary">Cause Name *</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Children Nutrition Drive" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold small text-secondary">Description *</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Explain the impact and goals of this cause..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" checked />
                    <label asp-for="IsActive" class="form-check-label fw-semibold small text-secondary">Accepting Donations Immediately</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary-green px-4 fw-semibold">
                        <i class="bi bi-check-lg me-1"></i>Save Cause
                    </button>
                    <a asp-action="Causes" class="btn btn-outline-secondary px-3">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

