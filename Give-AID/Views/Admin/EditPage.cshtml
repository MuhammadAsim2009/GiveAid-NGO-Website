@model Give_AID.Models.PageContents
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Edit {Model.Title}";
}

<div class="pt-3 pb-2 mb-3 border-bottom">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small mb-1">
            <li class="breadcrumb-item"><a asp-action="Pages" class="text-success text-decoration-none">Pages</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </ol>
    </nav>
    <h2 class="fw-bold text-dark mb-0">Edit Page: @Model.Title</h2>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
            <form asp-action="EditPage" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Slug" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold small text-secondary">Display Title *</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-secondary">Slug Identifier</label>
                    <input class="form-control font-monospace bg-light" value="@Model.Slug" readonly />
                    <small class="text-muted">Slug is fixed for system routing.</small>
                </div>

                <div class="mb-4">
                    <label asp-for="Body" class="form-label fw-semibold small text-secondary">Page Content (Body) *</label>
                    <textarea asp-for="Body" class="form-control" rows="10"></textarea>
                    <span asp-validation-for="Body" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary-green px-4 fw-semibold">
                        <i class="bi bi-check-lg me-1"></i>Save Changes
                    </button>
                    <a asp-action="Pages" class="btn btn-outline-secondary px-3">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

