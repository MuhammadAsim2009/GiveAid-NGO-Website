@model IEnumerable<Give_AID.Models.GalleryImages>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Media Gallery";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="font-size: 1.5rem; letter-spacing: -0.5px;">Media Gallery Management</h2>
        <p class="text-muted small mb-0">Upload and curate visual evidence from field distributions, camps, and activities.</p>
    </div>
    <button class="btn btn-saas-primary" data-bs-toggle="collapse" data-bs-target="#addImageForm">
        <i class="bi bi-cloud-arrow-up-fill"></i>
        <span>Add Photo Asset</span>
    </button>
</div>

<!-- Add Image Collapse Card with File Browser & Drag-and-Drop -->
<div class="collapse mb-4" id="addImageForm">
    <div class="saas-card">
        <div class="saas-card-header">
            <div class="saas-card-title">
                <i class="bi bi-image-fill text-success"></i>
                <span>Add Photo to Gallery</span>
            </div>
            <button type="button" class="btn-close" data-bs-toggle="collapse" data-bs-target="#addImageForm"></button>
        </div>
        <div class="saas-card-body">
            <form asp-action="CreateGalleryImage" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="row g-4">
                    <!-- Left: Metadata -->
                    <div class="col-12 col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark">Caption / Title <span class="text-danger">*</span></label>
                            <input name="Title" id="galleryTitleInput" class="form-control" placeholder="e.g. Free Ration Box Distribution" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark">Associated Campaign (Optional)</label>
                            <select name="ProgrammeId" class="form-select" asp-items="ViewBag.Programmes">
                                <option value="">-- General Portal Media --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark">Or Manual Web Path</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-link-45deg"></i></span>
                                <input name="ImagePath" id="galleryManualUrl" class="form-control" placeholder="/images/gallery/distribution.jpg or https://..." />
                            </div>
                        </div>
                    </div>

                    <!-- Right: File Browse Upload Zone -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold small text-dark">Image File <span class="text-danger">*</span></label>
                        
                        <input type="file" id="galleryFileInput" name="imageFile" class="d-none" accept="image/*" />

                        <div class="saas-image-upload-zone" id="galleryDropZone" onclick="document.getElementById('galleryFileInput').click();">
                            <div id="galleryPreviewBox" class="d-none mb-2">
                                <div class="saas-image-preview-card" onclick="event.stopPropagation();">
                                    <img id="galleryPreviewImg" src="#" alt="Selected Photo" />
                                    <button type="button" class="saas-preview-remove-btn" id="removeGalleryImgBtn" title="Remove photo">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                                <div id="galleryFileMeta" class="small text-muted mt-2 font-mono"></div>
                            </div>

                            <div id="galleryUploadPrompt">
                                <div class="saas-upload-icon">
                                    <i class="bi bi-image"></i>
                                </div>
                                <div class="fw-semibold text-dark small mb-1">Click to browse or drop photograph here</div>
                                <p class="text-muted small mb-0">JPEG, PNG, WebP supported</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <button type="submit" class="btn btn-saas-primary">
                        <i class="bi bi-check2"></i> Save Photo Asset
                    </button>
                    <button type="button" class="btn btn-saas-secondary" data-bs-toggle="collapse" data-bs-target="#addImageForm">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Visual Grid -->
<div class="saas-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="saas-card-title">
            <i class="bi bi-images text-primary"></i>
            <span>Published Media Assets (@(Model?.Count() ?? 0))</span>
        </div>
    </div>
    <div class="row g-3">
        @if (Model != null && Model.Any())
        {
            @foreach (var img in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-xl-3">
                    <div class="saas-card overflow-hidden h-100 border">
                        <div style="height: 180px; overflow: hidden; background: #0F172A; position: relative;">
                            <img src="@img.ImagePath" alt="@img.Title" class="w-100 h-100 object-fit-cover" onerror="this.src='/favicon.ico';" />
                            <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 start-0 m-2 small font-mono">
                                #@img.Id
                            </span>
                        </div>
                        <div class="p-3 d-flex justify-content-between align-items-center">
                            <div class="overflow-hidden pe-2">
                                <div class="fw-bold text-dark text-truncate" style="font-size: 0.9rem;" title="@img.Title">@img.Title</div>
                                <span class="small text-muted text-truncate d-block" style="font-size: 0.75rem;">
                                    <i class="bi bi-calendar-event me-1"></i>@(img.Programme?.Title ?? "General Media")
                                </span>
                            </div>
                            <form asp-action="DeleteGalleryImage" asp-route-id="@img.Id" method="post" onsubmit="return confirm('Delete this image?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-action-icon btn-action-icon-danger" title="Remove Photo">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-images fs-1 text-muted d-block mb-2"></i>
                <p class="mb-0 fw-semibold">No gallery photos added yet.</p>
                <span class="small text-muted">Click "Add Photo Asset" above to populate the gallery.</span>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const fileInput = document.getElementById("galleryFileInput");
        const dropZone = document.getElementById("galleryDropZone");
        const previewBox = document.getElementById("galleryPreviewBox");
        const previewImg = document.getElementById("galleryPreviewImg");
        const uploadPrompt = document.getElementById("galleryUploadPrompt");
        const fileMeta = document.getElementById("galleryFileMeta");
        const removeBtn = document.getElementById("removeGalleryImgBtn");
        const manualInput = document.getElementById("galleryManualUrl");

        function handleGalleryImage(file) {
            if (!file || !file.type.startsWith("image/")) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
                previewBox.classList.remove("d-none");
                uploadPrompt.classList.add("d-none");
                fileMeta.innerText = `${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
                if (!manualInput.value) {
                    manualInput.value = file.name;
                }
            };
            reader.readAsDataURL(file);
        }

        if (fileInput) {
            fileInput.addEventListener("change", function() {
                if (this.files && this.files[0]) {
                    handleGalleryImage(this.files[0]);
                }
            });
        }

        if (dropZone) {
            ['dragenter', 'dragover'].forEach(eventName => {
                dropZone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.classList.add('dragover');
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.classList.remove('dragover');
                }, false);
            });

            dropZone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files && files[0]) {
                    fileInput.files = files;
                    handleGalleryImage(files[0]);
                }
            }, false);
        }

        if (removeBtn) {
            removeBtn.addEventListener("click", function(e) {
                e.stopPropagation();
                fileInput.value = "";
                previewImg.src = "#";
                previewBox.classList.add("d-none");
                uploadPrompt.classList.remove("d-none");
            });
        }
    </script>
}
