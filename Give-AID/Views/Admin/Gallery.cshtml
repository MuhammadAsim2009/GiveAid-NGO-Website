@model IEnumerable<Give_AID.Models.GalleryImages>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Gallery";
}

<div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <div>
        <h2 class="fw-bold text-dark mb-0">Photo Gallery</h2>
        <p class="text-muted small mb-0">Upload and showcase images from charity relief and distributions</p>
    </div>
    <button class="btn btn-primary-green btn-sm fw-semibold" data-bs-toggle="collapse" data-bs-target="#addImageForm">
        <i class="bi bi-plus-circle me-1"></i>Add Photo
    </button>
</div>

<!-- Add Image Collapse Box -->
<div class="collapse mb-4" id="addImageForm">
    <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
        <h5 class="fw-bold mb-3 text-dark">Add New Photo to Gallery</h5>
        <form asp-action="CreateGalleryImage" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold small text-secondary">Photo Title / Caption *</label>
                    <input name="Title" class="form-control" placeholder="e.g. Flood Relief Distribution" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small text-secondary">Image Path / URL *</label>
                    <input name="ImagePath" class="form-control" placeholder="/images/gallery/photo1.jpg" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small text-secondary">Linked Programme (Optional)</label>
                    <select name="ProgrammeId" class="form-select" asp-items="ViewBag.Programmes">
                        <option value="">-- General Gallery Photo --</option>
                    </select>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary-green btn-sm px-4 fw-semibold">Save Photo</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#addImageForm">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- Gallery Grid -->
<div class="row g-3">
    @if (Model != null && Model.Any())
    {
        @foreach (var img in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden h-100">
                    <div style="height: 180px; overflow: hidden; background-color: #f3f4f6;" class="d-flex align-items-center justify-content-center">
                        <img src="@img.ImagePath" alt="@img.Title" class="w-100 h-100 object-fit-cover" onerror="this.src='/images/placeholder.png';" />
                    </div>
                    <div class="p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-0 text-truncate" style="max-width: 160px;">@img.Title</h6>
                            <span class="small text-muted">@(img.Programme?.Title ?? "General")</span>
                        </div>
                        <form asp-action="DeleteGalleryImage" asp-route-id="@img.Id" method="post" onsubmit="return confirm('Delete this image?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="p-4 bg-white rounded-3 shadow-sm text-muted">
                <i class="bi bi-images fs-1 d-block mb-2 text-muted"></i>
                No gallery photos added yet. Click <strong>Add Photo</strong> to begin showcasing media.
            </div>
        </div>
    }
</div>

