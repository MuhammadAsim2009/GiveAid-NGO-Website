@model IEnumerable<Give_AID.Models.Partners>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Corporate Partners";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="font-size: 1.5rem; letter-spacing: -0.5px;">Corporate Partners & Sponsors</h2>
        <p class="text-muted small mb-0">Manage corporate allies, CSR donors, and institutional welfare partners.</p>
    </div>
    <a asp-action="CreatePartner" class="btn btn-saas-primary">
        <i class="bi bi-plus-lg"></i>
        <span>Add Partner</span>
    </a>
</div>

<!-- SaaS Table Card -->
<div class="saas-card">
    <div class="saas-card-header">
        <div class="saas-card-title">
            <i class="bi bi-award-fill text-success"></i>
            <span>Active Strategic Sponsors</span>
        </div>
        <div class="saas-table-search">
            <i class="bi bi-search"></i>
            <input type="text" id="partnerSearchInput" class="form-control form-control-sm" placeholder="Search partners..." onkeyup="filterPartnerTable()" />
        </div>
    </div>
    <div class="p-0">
        <div class="table-responsive">
            <table class="saas-table align-middle" id="partnerTable">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Corporate Entity</th>
                        <th>Asset Logo Location</th>
                        <th>Verified Website</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var partner in Model)
                        {
                            <tr>
                                <td>
                                    <span class="font-mono text-muted small">#@partner.Id</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle" style="background: linear-gradient(135deg, #10B981, #047857);">
                                            @partner.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <div class="fw-bold text-dark" style="font-size: 0.95rem;">@partner.Name</div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-muted border font-mono">
                                        @(string.IsNullOrEmpty(partner.LogoPath) ? "Default Asset" : partner.LogoPath)
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(partner.Website))
                                    {
                                        <a href="@partner.Website" target="_blank" class="fw-semibold text-decoration-none" style="color: #2563EB;">
                                            @partner.Website <i class="bi bi-box-arrow-up-right small"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Not provided</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="EditPartner" asp-route-id="@partner.Id" class="btn-action-icon btn-action-icon-primary" title="Edit Partner">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="DeletePartner" asp-route-id="@partner.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this partner?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-action-icon btn-action-icon-danger" title="Delete Partner">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 text-muted d-block mb-2"></i>
                                No corporate sponsors registered yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function filterPartnerTable() {
        const input = document.getElementById("partnerSearchInput").value.toLowerCase();
        const rows = document.querySelectorAll("#partnerTable tbody tr");
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = text.includes(input) ? "" : "none";
        });
    }
</script>
}
