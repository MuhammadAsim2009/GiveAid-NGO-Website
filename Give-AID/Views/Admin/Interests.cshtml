@model IEnumerable<Give_AID.Models.ProgrammeInterests>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Programme Volunteer Interests";
}

<div class="pt-3 pb-2 mb-3 border-bottom">
    <h2 class="fw-bold text-dark mb-0">Programme Volunteer Interests</h2>
    <p class="text-muted small mb-0">Submissions from donors expressing interest to participate in welfare events</p>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th>#</th>
                        <th>Member Name</th>
                        <th>Email / Contact</th>
                        <th>Programme Title</th>
                        <th>Message / Availability</th>
                        <th>Registered On</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var interest in Model)
                        {
                            <tr>
                                <td>@interest.Id</td>
                                <td class="fw-bold">@(interest.User?.Name ?? "Member")</td>
                                <td class="small">
                                    @(interest.User?.Email ?? "-")
                                    @if (!string.IsNullOrEmpty(interest.User?.Phone))
                                    {
                                        <br /><span class="text-muted">@interest.User.Phone</span>
                                    }
                                </td>
                                <td class="fw-semibold text-primary">@(interest.Programme?.Title ?? "General Programme")</td>
                                <td class="small text-muted">@(interest.Message ?? "Interested in volunteering.")</td>
                                <td class="small text-muted">@interest.CreatedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No volunteer expressions of interest submitted yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

