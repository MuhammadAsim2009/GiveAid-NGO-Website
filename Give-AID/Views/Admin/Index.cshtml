@model Give_AID.Models.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Executive Dashboard";
}

<!-- ── Welcome Header Strip ──────────────────────────────────────────────── -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="font-size: 1.6rem; letter-spacing: -0.5px;">Executive Dashboard</h2>
        <p class="text-muted small mb-0">Real-time overview of welfare operations, transactions, and community activity.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="CreateCause" class="btn btn-saas-primary">
            <i class="bi bi-plus-lg"></i>
            <span>New Cause</span>
        </a>
        <a asp-action="CreateProgramme" class="btn btn-saas-secondary">
            <i class="bi bi-calendar-plus"></i>
            <span>New Programme</span>
        </a>
    </div>
</div>

<!-- ── KPI Stat Cards (4 Columns) ────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <!-- Card 1: Total Funds Raised -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="saas-stat-card">
            <div>
                <div class="saas-stat-header">
                    <div>
                        <div class="saas-stat-label">Total Contributions</div>
                        <div class="saas-stat-value font-mono" style="color: #059669;">
                            $@Model.TotalFundsRaised.ToString("N0")
                        </div>
                    </div>
                    <div class="saas-stat-icon stat-icon-emerald">
                        <i class="bi bi-wallet2"></i>
                    </div>
                </div>
            </div>
            <div class="saas-stat-footer">
                <span class="text-muted">Direct to verified causes</span>
                <a asp-action="Donations" class="fw-semibold text-decoration-none" style="color: #059669;">
                    Audit log <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Card 2: Registered Donors / Members -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="saas-stat-card">
            <div>
                <div class="saas-stat-header">
                    <div>
                        <div class="saas-stat-label">Active Members</div>
                        <div class="saas-stat-value font-mono" style="color: #2563EB;">
                            @Model.TotalMembersCount
                        </div>
                    </div>
                    <div class="saas-stat-icon stat-icon-blue">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
            <div class="saas-stat-footer">
                <span class="text-muted">Community membership</span>
                <a asp-action="Members" class="fw-semibold text-decoration-none" style="color: #2563EB;">
                    View roster <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Card 3: Open Support Queries -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="saas-stat-card">
            <div>
                <div class="saas-stat-header">
                    <div>
                        <div class="saas-stat-label">Pending Inquiries</div>
                        <div class="saas-stat-value font-mono" style="color: #D97706;">
                            @Model.OpenQueriesCount
                        </div>
                    </div>
                    <div class="saas-stat-icon stat-icon-amber">
                        <i class="bi bi-chat-left-dots-fill"></i>
                    </div>
                </div>
            </div>
            <div class="saas-stat-footer">
                <span class="text-muted">Awaiting administrator response</span>
                <a asp-action="Queries" class="fw-semibold text-decoration-none" style="color: #D97706;">
                    Reply now <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Card 4: Partner NGOs Network -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="saas-stat-card">
            <div>
                <div class="saas-stat-header">
                    <div>
                        <div class="saas-stat-label">Affiliated NGOs</div>
                        <div class="saas-stat-value font-mono" style="color: #4F46E5;">
                            @Model.TotalNgosCount
                        </div>
                    </div>
                    <div class="saas-stat-icon stat-icon-indigo">
                        <i class="bi bi-buildings-fill"></i>
                    </div>
                </div>
            </div>
            <div class="saas-stat-footer">
                <span class="text-muted">Authorized charities</span>
                <a asp-action="Ngos" class="fw-semibold text-decoration-none" style="color: #4F46E5;">
                    Manage NGOs <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ── Main Grid: Recent Activity ────────────────────────────────────────── -->
<div class="row g-4">

    <!-- Left Column: Recent Donations Feed -->
    <div class="col-12 col-lg-7">
        <div class="saas-card h-100">
            <div class="saas-card-header">
                <div class="saas-card-title">
                    <i class="bi bi-receipt text-success"></i>
                    <span>Recent Transactions</span>
                </div>
                <a asp-action="Donations" class="btn btn-sm btn-saas-secondary">
                    <span>View All</span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="p-0">
                <div class="table-responsive">
                    <table class="saas-table align-middle">
                        <thead>
                            <tr>
                                <th>Donor</th>
                                <th>Cause</th>
                                <th>Amount</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentDonations.Any())
                            {
                                @foreach (var don in Model.RecentDonations)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="avatar-circle" style="background: linear-gradient(135deg, #10B981, #059669);">
                                                    @((don.User?.Name ?? "A").Substring(0, 1).ToUpper())
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark" style="font-size:0.875rem;">
                                                        @(don.User?.Name ?? "Anonymous Donor")
                                                    </div>
                                                    <div class="small text-muted" style="font-size:0.75rem;">
                                                        @if (don.PaymentMethod == "Card")
                                                        {
                                                            <span>Card: •••• @(don.CardLast4 ?? "----")</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@don.PaymentMethod @(!string.IsNullOrEmpty(don.TransactionRef) ? $"Ref: {don.TransactionRef}" : "")</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-2 py-1" style="font-weight:500;">
                                                @(don.Cause?.Name ?? "General Relief")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="font-mono fw-bold" style="color: #059669;">
                                                $@don.Amount.ToString("N2")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="text-muted small">
                                                @don.CreatedAt.ToString("MMM dd, HH:mm")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge-status badge-status-success">
                                                @don.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-2 text-muted d-block mb-2"></i>
                                        No recent donations logged in database.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Support Tickets & Action Items -->
    <div class="col-12 col-lg-5">
        <div class="saas-card h-100">
            <div class="saas-card-header">
                <div class="saas-card-title">
                    <i class="bi bi-chat-square-quote text-warning"></i>
                    <span>Inquiries Awaiting Action</span>
                </div>
                <a asp-action="Queries" class="btn btn-sm btn-saas-secondary">
                    <span>Help Desk</span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="p-3">
                @if (Model.RecentQueries.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var q in Model.RecentQueries)
                        {
                            <div class="p-3 rounded-3 border" style="background: #F8FAFC; border-color: #E2E8F0 !important;">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-dark small">
                                        <i class="bi bi-person-circle text-muted me-1"></i>@(q.User?.Name ?? "Registered Member")
                                    </span>
                                    @if (q.Status == "Open")
                                    {
                                        <span class="badge-status badge-status-warning">Open</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-status-success">@q.Status</span>
                                    }
                                </div>
                                <div class="fw-semibold text-dark text-truncate mb-1" style="font-size: 0.9rem;">
                                    @q.Subject
                                </div>
                                <div class="text-muted small text-truncate mb-2" style="font-size: 0.8rem;">
                                    @q.Message
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                    <span class="text-muted" style="font-size: 0.72rem;">
                                        @q.CreatedAt.ToString("MMM dd, yyyy")
                                    </span>
                                    <a asp-action="Queries" class="btn btn-sm btn-outline-success py-0 px-2" style="font-size: 0.75rem;">
                                        Reply &rarr;
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-check2-circle fs-1 text-success d-block mb-2"></i>
                        <p class="mb-0 fw-semibold">Inbox Zero!</p>
                        <span class="small text-muted">All inquiries have been addressed.</span>
                    </div>
                }
            </div>
        </div>
    </div>

</div>
