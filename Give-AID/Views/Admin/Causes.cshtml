@model IEnumerable<Give_AID.Models.Causes>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Causes";
}

<div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <div>
        <h2 class="fw-bold text-dark mb-0">Charitable Causes</h2>
        <p class="text-muted small mb-0">Define welfare sectors that donors can contribute towards</p>
    </div>
    <a asp-action="CreateCause" class="btn btn-primary-green btn-sm fw-semibold">
        <i class="bi bi-plus-circle me-1"></i>Add New Cause
    </a>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th>#</th>
                        <th>Cause Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Total Donations</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var cause in Model)
                        {
                            <tr>
                                <td>@cause.Id</td>
                                <td class="fw-bold">@cause.Name</td>
                                <td class="small text-muted text-truncate" style="max-width: 300px;">@cause.Description</td>
                                <td>
                                    @if (cause.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(cause.Donations?.Count ?? 0) donations
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="EditCause" asp-route-id="@cause.Id" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteCause" asp-route-id="@cause.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete or deactivate this cause?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No causes registered yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

