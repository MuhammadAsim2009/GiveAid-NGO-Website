@model Give_AID.Models.Programmes
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create Programme";
}

<div class="pt-3 pb-2 mb-3 border-bottom">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small mb-1">
            <li class="breadcrumb-item"><a asp-action="Programmes" class="text-success text-decoration-none">Programmes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Create</li>
        </ol>
    </nav>
    <h2 class="fw-bold text-dark mb-0">Create Welfare Programme</h2>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
            <form asp-action="CreateProgramme" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold small text-secondary">Programme Title *</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Free Eye Screening Camp" autofocus />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label fw-semibold small text-secondary">Category *</label>
                        <select asp-for="Category" class="form-select">
                            <option value="Education">Education</option>
                            <option value="Health Care">Health Care</option>
                            <option value="Specially Challenged Children">Specially Challenged Children</option>
                            <option value="Community Relief">Community Relief</option>
                            <option value="Women Empowerment">Women Empowerment</option>
                            <option value="Elderly Care">Elderly Care</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NgoId" class="form-label fw-semibold small text-secondary">Host NGO *</label>
                        <select asp-for="NgoId" class="form-select" asp-items="ViewBag.Ngos">
                            <option value="">-- Select Partner NGO --</option>
                        </select>
                        <span asp-validation-for="NgoId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDate" class="form-label fw-semibold small text-secondary">Event Date *</label>
                    <input asp-for="EventDate" class="form-control" type="date" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="EventDate" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold small text-secondary">Detailed Description *</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Detail the activities, location, and volunteer tasks..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary-green px-4 fw-semibold">
                        <i class="bi bi-check-lg me-1"></i>Publish Programme
                    </button>
                    <a asp-action="Programmes" class="btn btn-outline-secondary px-3">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

