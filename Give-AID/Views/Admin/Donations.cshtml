@model IEnumerable<Give_AID.Models.Donations>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "All Donations";
}

<div class="pt-3 pb-2 mb-3 border-bottom">
    <h2 class="fw-bold text-dark mb-0">Donation Transactions</h2>
    <p class="text-muted small mb-0">Complete audit log of all financial contributions received</p>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th>Receipt #</th>
                        <th>Donor Name</th>
                        <th>Cause</th>
                        <th>Directed NGO</th>
                        <th>Amount</th>
                        <th>Card</th>
                        <th>Transaction Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var don in Model)
                        {
                            <tr>
                                <td class="font-monospace fw-semibold">#DON-@don.Id.ToString("D5")</td>
                                <td class="fw-bold">@(don.User?.Name ?? "Anonymous")</td>
                                <td>@(don.Cause?.Name ?? "General Relief")</td>
                                <td class="small text-muted">@(don.Ngo?.Name ?? "Any Partner NGO")</td>
                                <td class="fw-bold text-success">Rs. @don.Amount.ToString("N0")</td>
                                <td class="small text-muted">•••• @don.CardLast4</td>
                                <td class="small text-muted">@don.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>
                                    <span class="badge bg-success-subtle text-success">@don.Status</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No donations recorded yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

