@model IEnumerable<Give_AID.Models.Programmes>
@{
    ViewData["Title"] = "Welfare Programmes - GIVE-AID";
    string selectedCategory = ViewBag.SelectedCategory as string ?? "";
}

<section class="py-4 bg-light border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Programmes</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-1" style="color: #1E8E5A;">Welfare Programmes & Activities</h2>
        <p class="text-muted mb-0">Browse humanitarian programmes organized by partner NGOs. Volunteer or register your interest.</p>
    </div>
</section>

<div class="container py-5">
    <!-- Category Filter Pills -->
    <div class="d-flex flex-wrap gap-2 mb-4 justify-content-center">
        <a asp-action="Programmes" class="btn btn-sm rounded-pill px-3 @(string.IsNullOrEmpty(selectedCategory) ? "btn-primary-green" : "btn-outline-secondary")">
            All Programmes
        </a>
        <a asp-action="Programmes" asp-route-category="Education" class="btn btn-sm rounded-pill px-3 @(selectedCategory.Equals("Education", StringComparison.OrdinalIgnoreCase) ? "btn-primary-green" : "btn-outline-secondary")">
            Education
        </a>
        <a asp-action="Programmes" asp-route-category="Health Care" class="btn btn-sm rounded-pill px-3 @(selectedCategory.Equals("Health Care", StringComparison.OrdinalIgnoreCase) ? "btn-primary-green" : "btn-outline-secondary")">
            Health Care
        </a>
        <a asp-action="Programmes" asp-route-category="Specially Challenged Children" class="btn btn-sm rounded-pill px-3 @(selectedCategory.Equals("Specially Challenged Children", StringComparison.OrdinalIgnoreCase) ? "btn-primary-green" : "btn-outline-secondary")">
            Specially Challenged Children
        </a>
        <a asp-action="Programmes" asp-route-category="Community Relief" class="btn btn-sm rounded-pill px-3 @(selectedCategory.Equals("Community Relief", StringComparison.OrdinalIgnoreCase) ? "btn-primary-green" : "btn-outline-secondary")">
            Community Relief
        </a>
    </div>

    <!-- Programmes Grid -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var programme in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="giveaid-card p-4 h-100 d-flex flex-column justify-content-between bg-white">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-success-subtle text-success fw-semibold px-3 py-2">
                                    @programme.Category
                                </span>
                                <span class="small text-muted">
                                    <i class="bi bi-calendar-event me-1 text-danger"></i>@programme.EventDate.ToString("MMM dd, yyyy")
                                </span>
                            </div>

                            <h4 class="fw-bold mb-2">@programme.Title</h4>
                            <p class="text-muted small mb-3">@programme.Description</p>

                            @if (programme.Ngo != null)
                            {
                                <div class="p-2 rounded-2 bg-light small mb-3 text-secondary">
                                    <i class="bi bi-building me-1 text-success"></i>Host NGO: <strong>@programme.Ngo.Name</strong>
                                    <br />
                                    <i class="bi bi-telephone me-1 text-muted"></i>Contact: @programme.Ngo.Contact
                                </div>
                            }
                        </div>

                        <div class="mt-3 pt-3 border-top d-flex gap-2">
                            <a asp-controller="Programme" asp-action="Details" asp-route-id="@programme.Id" class="btn btn-primary-green btn-sm w-100 fw-semibold">
                                <i class="bi bi-star me-1"></i>Register Interest
                            </a>
                            <a asp-controller="Donation" asp-action="Create" class="btn btn-donate-amber btn-sm px-3 fw-bold">
                                Sponsor
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="p-5 bg-white rounded-3 shadow-sm">
                    <i class="bi bi-calendar-x display-3 text-muted mb-3 d-inline-block"></i>
                    <h4 class="fw-bold text-secondary">No Programmes Found</h4>
                    <p class="text-muted mb-3">There are currently no active programmes listed in this category.</p>
                    <a asp-action="Programmes" class="btn btn-primary-green btn-sm px-4">View All Programmes</a>
                </div>
            </div>
        }
    </div>
</div>

