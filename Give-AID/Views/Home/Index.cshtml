@model Give_AID.Models.HomeViewModel
@{
    ViewData["Title"] = "GIVE-AID - Empowering NGOs & Transforming Lives";
}

<!-- Hero Section with Inspiring Call to Action -->
<section class="py-5" style="background: linear-gradient(135deg, #e8f5ee 0%, #fef3c7 100%); border-radius: 0 0 2rem 2rem;">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="badge rounded-pill px-3 py-2 fw-semibold text-white mb-3" style="background-color: #1E8E5A;">
                    <i class="bi bi-heart-fill me-1 text-warning"></i> Trusted Charity Platform
                </span>
                <h1 class="display-4 fw-bold mb-3" style="color: #1F2937; line-height: 1.2;">
                    Connecting Generous Hearts With Noble Causes
                </h1>
                <p class="lead text-muted mb-4">
                    GIVE-AID bridges the gap between passionate donors and certified welfare NGOs. Together, we fund education, healthcare, nutrition, and empowerment programmes for underprivileged communities.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Donation" asp-action="Create" class="btn btn-donate-amber btn-lg px-4 shadow">
                        <i class="bi bi-heart-fill me-2"></i>Donate Now
                    </a>
                    <a href="#causes-section" class="btn btn-primary-green btn-lg px-4 shadow-sm">
                        <i class="bi bi-grid-fill me-2"></i>Explore Causes
                    </a>
                    <a asp-controller="Home" asp-action="Programmes" class="btn btn-outline-secondary btn-lg px-4 bg-white">
                        <i class="bi bi-calendar-check me-2"></i>View Programmes
                    </a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="giveaid-card p-4 bg-white shadow-lg text-center position-relative">
                    <div class="mb-3">
                        <span class="display-1 text-success"><i class="bi bi-globe-americas"></i></span>
                    </div>
                    <h3 class="fw-bold mb-2">Every Penny Counts</h3>
                    <p class="text-muted small mb-4">
                        Your direct contributions fund essential medicines, school supplies, clean water, and relief packages for families in need.
                    </p>
                    <div class="p-3 rounded-3 bg-light mb-3 text-start">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                            <span class="small fw-semibold">100% Verified Non-Profit Partners</span>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                            <span class="small fw-semibold">Zero Commission On Welfare Relief</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                            <span class="small fw-semibold">Instant Digital Donation Receipts</span>
                        </div>
                    </div>
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-green w-100 fw-semibold">
                        Register As A Donor
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Impact Metrics Strip -->
<section class="py-4 my-2">
    <div class="container">
        <div class="row g-3 text-center">
            <div class="col-md-3 col-6">
                <div class="giveaid-card p-3 h-100 border-start border-4 border-success">
                    <h2 class="fw-bold text-success mb-1">
                        Rs. @(Model.TotalFundsRaised > 0 ? Model.TotalFundsRaised.ToString("N0") : "550,000+")
                    </h2>
                    <span class="text-muted small text-uppercase fw-semibold">Funds Raised</span>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="giveaid-card p-3 h-100 border-start border-4 border-warning">
                    <h2 class="fw-bold text-warning mb-1">
                        @(Model.TotalDonationsCount > 0 ? Model.TotalDonationsCount.ToString() : "1,240+")
                    </h2>
                    <span class="text-muted small text-uppercase fw-semibold">Successful Donations</span>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="giveaid-card p-3 h-100 border-start border-4 border-primary">
                    <h2 class="fw-bold text-primary mb-1">
                        @(Model.TotalMembersCount > 0 ? Model.TotalMembersCount.ToString() : "850+")
                    </h2>
                    <span class="text-muted small text-uppercase fw-semibold">Active Donors</span>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="giveaid-card p-3 h-100 border-start border-4 border-info">
                    <h2 class="fw-bold text-info mb-1">
                        @(Model.TotalNgosCount > 0 ? Model.TotalNgosCount.ToString() : "18+")
                    </h2>
                    <span class="text-muted small text-uppercase fw-semibold">Partner NGOs</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Causes Section -->
<section id="causes-section" class="py-5 bg-white">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4">
            <div>
                <span class="text-uppercase small fw-bold text-success">Where Your Support Goes</span>
                <h2 class="fw-bold mb-1">Urgent Charitable Causes</h2>
                <p class="text-muted mb-0">Select a welfare sector to directly support verified community projects.</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-controller="Donation" asp-action="Create" class="btn btn-outline-green btn-sm fw-semibold">
                    View All Causes <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="row g-4">
            @if (Model.FeaturedCauses.Any())
            {
                @foreach (var cause in Model.FeaturedCauses)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="giveaid-card p-4 h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="p-2 rounded-circle bg-success-subtle text-success fs-4">
                                        <i class="bi bi-heart-pulse"></i>
                                    </span>
                                    <span class="badge bg-success-subtle text-success">Active Campaign</span>
                                </div>
                                <h4 class="fw-bold mb-2">@cause.Name</h4>
                                <p class="text-muted small mb-4">@cause.Description</p>
                            </div>
                            <div>
                                <a asp-controller="Donation" asp-action="Create" asp-route-causeId="@cause.Id" class="btn btn-donate-amber w-100 fw-semibold">
                                    <i class="bi bi-wallet2 me-1"></i>Donate to this Cause
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-md-4">
                    <div class="giveaid-card p-4 h-100">
                        <span class="p-2 rounded-circle bg-success-subtle text-success fs-4 d-inline-block mb-3">
                            <i class="bi bi-book"></i>
                        </span>
                        <h4 class="fw-bold mb-2">Child Education & Nutrition</h4>
                        <p class="text-muted small mb-4">Sponsoring primary school books, uniforms, and daily balanced meals for street children.</p>
                        <a asp-controller="Donation" asp-action="Create" class="btn btn-donate-amber w-100 fw-semibold">Donate Now</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="giveaid-card p-4 h-100">
                        <span class="p-2 rounded-circle bg-success-subtle text-success fs-4 d-inline-block mb-3">
                            <i class="bi bi-hospital"></i>
                        </span>
                        <h4 class="fw-bold mb-2">Emergency Healthcare Camps</h4>
                        <p class="text-muted small mb-4">Free diagnostic screenings, essential medicines, and maternal healthcare in rural villages.</p>
                        <a asp-controller="Donation" asp-action="Create" class="btn btn-donate-amber w-100 fw-semibold">Donate Now</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="giveaid-card p-4 h-100">
                        <span class="p-2 rounded-circle bg-success-subtle text-success fs-4 d-inline-block mb-3">
                            <i class="bi bi-person-wheelchair"></i>
                        </span>
                        <h4 class="fw-bold mb-2">Specially Challenged Support</h4>
                        <p class="text-muted small mb-4">Providing motorized wheelchairs, hearing aids, and specialized vocational computer training.</p>
                        <a asp-controller="Donation" asp-action="Create" class="btn btn-donate-amber w-100 fw-semibold">Donate Now</a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Upcoming Welfare Programmes -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4">
            <div>
                <span class="text-uppercase small fw-bold text-success">Grassroots Action</span>
                <h2 class="fw-bold mb-1">Upcoming NGO Programmes</h2>
                <p class="text-muted mb-0">Join, volunteer, or sponsor welfare initiatives organized by our verified partners.</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-controller="Home" asp-action="Programmes" class="btn btn-primary-green btn-sm fw-semibold">
                    View All Programmes <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="row g-4">
            @if (Model.UpcomingProgrammes.Any())
            {
                @foreach (var prog in Model.UpcomingProgrammes)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="giveaid-card p-4 h-100 d-flex flex-column justify-content-between bg-white">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-primary-subtle text-primary fw-semibold">@prog.Category</span>
                                    <span class="small text-muted"><i class="bi bi-calendar3 me-1"></i>@prog.EventDate.ToString("MMM dd, yyyy")</span>
                                </div>
                                <h5 class="fw-bold mb-2">@prog.Title</h5>
                                <p class="text-muted small mb-3">@prog.Description</p>
                                @if (prog.Ngo != null)
                                {
                                    <div class="small text-secondary mb-3">
                                        <i class="bi bi-building me-1 text-success"></i>Organized by: <strong>@prog.Ngo.Name</strong>
                                    </div>
                                }
                            </div>
                            <div>
                                <a asp-controller="Programme" asp-action="Details" asp-route-id="@prog.Id" class="btn btn-outline-green w-100 btn-sm fw-semibold">
                                    Express Interest / Volunteer
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-lg-4 col-md-6">
                    <div class="giveaid-card p-4 h-100 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary-subtle text-primary">Education</span>
                            <span class="small text-muted"><i class="bi bi-calendar3 me-1"></i>Upcoming</span>
                        </div>
                        <h5 class="fw-bold mb-2">Digital Literacy Drive For Slum Schools</h5>
                        <p class="text-muted small mb-3">Deploying 50 refurbished laptops and internet access to 5 underprivileged community schools.</p>
                        <a asp-controller="Home" asp-action="Programmes" class="btn btn-outline-green w-100 btn-sm fw-semibold">Learn More</a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="giveaid-card p-4 h-100 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-success-subtle text-success">Healthcare</span>
                            <span class="small text-muted"><i class="bi bi-calendar3 me-1"></i>Upcoming</span>
                        </div>
                        <h5 class="fw-bold mb-2">Free Eye Screening & Cataract Surgeries</h5>
                        <p class="text-muted small mb-3">Conducting 200 free cataract replacement operations and distributing 1,000 reading glasses.</p>
                        <a asp-controller="Home" asp-action="Programmes" class="btn btn-outline-green w-100 btn-sm fw-semibold">Learn More</a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="giveaid-card p-4 h-100 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-warning-subtle text-warning">Special Care</span>
                            <span class="small text-muted"><i class="bi bi-calendar3 me-1"></i>Upcoming</span>
                        </div>
                        <h5 class="fw-bold mb-2">Assistive Hearing Aid Distribution</h5>
                        <p class="text-muted small mb-3">Empowering 80 hearing-impaired children with digital auditory assistance devices.</p>
                        <a asp-controller="Home" asp-action="Programmes" class="btn btn-outline-green w-100 btn-sm fw-semibold">Learn More</a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Why Choose GIVE-AID Feature Grid -->
<section class="py-5 bg-white">
    <div class="container text-center">
        <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2 mb-2">Transparent Giving</span>
        <h2 class="fw-bold mb-2">Why Support Welfare With GIVE-AID?</h2>
        <p class="text-muted mb-5">We ensure absolute accountability, rigorous partner vetting, and zero hidden deductions.</p>

        <div class="row g-4 text-start">
            <div class="col-md-4">
                <div class="p-3">
                    <div class="fs-2 text-success mb-2"><i class="bi bi-shield-check"></i></div>
                    <h5 class="fw-bold mb-2">100% Vetted NGOs</h5>
                    <p class="text-muted small">Every associated NGO undergoes strict legal, financial, and regulatory verification before listing programmes.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3">
                    <div class="fs-2 text-warning mb-2"><i class="bi bi-receipt-cutoff"></i></div>
                    <h5 class="fw-bold mb-2">Transparent Receipts</h5>
                    <p class="text-muted small">Access your complete donation history, downloadable receipts, and live status of funds utilized on the ground.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3">
                    <div class="fs-2 text-primary mb-2"><i class="bi bi-people"></i></div>
                    <h5 class="fw-bold mb-2">Direct Volunteer Impact</h5>
                    <p class="text-muted small">Donors can register interest to actively volunteer, visit welfare camps, and see their contributions at work.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Corporate Partners Strip -->
<section class="py-5 bg-light border-top">
    <div class="container text-center">
        <span class="text-uppercase small fw-bold text-muted d-block mb-3">Our Valued Corporate & Strategic Partners</span>
        <div class="row justify-content-center align-items-center g-4">
            <div class="col-6 col-md-2">
                <div class="p-3 bg-white rounded-3 shadow-sm fw-bold text-muted">TechWelfare</div>
            </div>
            <div class="col-6 col-md-2">
                <div class="p-3 bg-white rounded-3 shadow-sm fw-bold text-muted">GlobalCare</div>
            </div>
            <div class="col-6 col-md-2">
                <div class="p-3 bg-white rounded-3 shadow-sm fw-bold text-muted">HopeCorp</div>
            </div>
            <div class="col-6 col-md-2">
                <div class="p-3 bg-white rounded-3 shadow-sm fw-bold text-muted">ApexPharma</div>
            </div>
            <div class="col-6 col-md-2">
                <div class="p-3 bg-white rounded-3 shadow-sm fw-bold text-muted">FutureEd</div>
            </div>
        </div>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Partners" class="text-success text-decoration-none fw-semibold small">
                Explore All Partners & Sponsorship Opportunities <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</section>

<!-- Final Call-to-Action Banner (No Blank Space) -->
<section class="py-5" style="background-color: #1E8E5A; color: #ffffff;">
    <div class="container text-center py-3">
        <h2 class="fw-bold text-white mb-3">Ready to Make an Everlasting Difference?</h2>
        <p class="lead mb-4 text-white-50">Join over 800+ registered donors and help us provide hope, nutrition, and dignity today.</p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Donation" asp-action="Create" class="btn btn-donate-amber btn-lg px-5 shadow fw-bold">
                Donate Now
            </a>
            <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-light btn-lg px-4 fw-semibold">
                Join Community
            </a>
        </div>
    </div>
</section>
