@model Give_AID.Models.HomeViewModel
@{
    ViewData["Title"] = "GIVE-AID - Transparent Philanthropy & Community Relief";
}

<!-- Hero Section with SaaS Modern Gradient & Floating Glassmorphism -->
<section class="py-5 position-relative overflow-hidden" style="background: radial-gradient(circle at 10% 20%, rgba(16, 185, 129, 0.08) 0%, rgba(248, 250, 252, 1) 90%);">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <!-- Left Hero Content -->
            <div class="col-12 col-lg-7">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white border shadow-sm mb-3">
                    <span class="badge bg-success rounded-pill font-mono px-2 py-1" style="font-size:0.7rem;">Verified</span>
                    <span class="small fw-semibold text-dark">Zero Platform Fee • 100% Directed Impact</span>
                </div>

                <h1 class="display-4 fw-bold mb-3 text-dark" style="letter-spacing: -1.5px; line-height: 1.15;">
                    Empowering Non-Profits. <br />
                    <span style="color: #059669;">Transforming Human Lives.</span>
                </h1>

                <p class="lead text-muted mb-4" style="font-size: 1.1rem; line-height: 1.7; max-width: 600px;">
                    GIVE-AID is an accountable welfare portal uniting compassionate donors with accredited charities to deliver emergency medical camps, clean drinking water, education kits, and community relief.
                </p>

                <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                    <a asp-controller="Donation" asp-action="Create" class="btn btn-donate-amber btn-lg px-4 py-3 rounded-pill shadow-sm fw-bold">
                        <i class="bi bi-heart-fill me-2 text-danger"></i>Make a Contribution
                    </a>
                    <a href="#causes-section" class="btn btn-outline-secondary btn-lg px-4 py-3 rounded-pill bg-white fw-semibold">
                        <i class="bi bi-grid-fill me-2 text-success"></i>Explore Causes
                    </a>
                </div>

                <!-- Trust Strip -->
                <div class="d-flex align-items-center gap-4 pt-2 text-muted small">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <span>Audited Ledger</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-check text-success fs-5"></i>
                        <span>Instant Tax Receipts</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-bank text-success fs-5"></i>
                        <span>EasyPaisa & JazzCash</span>
                    </div>
                </div>
            </div>

            <!-- Right Hero Card -->
            <div class="col-12 col-lg-5">
                <div class="giveaid-card p-4 p-md-5 bg-white border shadow-lg position-relative" style="border-radius: 1.25rem;">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <span class="text-uppercase small fw-bold text-success font-mono">Live Impact</span>
                            <h4 class="fw-bold text-dark mb-0">Total Funds Directed</h4>
                        </div>
                        <div class="d-flex align-items-center justify-content-center rounded-3 bg-success-subtle text-success" style="width: 48px; height: 48px;">
                            <i class="bi bi-wallet2 fs-4"></i>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="display-6 fw-bold font-mono text-dark" style="color: #059669 !important;">
                            Rs. @(Model.TotalFundsRaised > 0 ? Model.TotalFundsRaised.ToString("N0") : "750,000")
                        </div>
                        <div class="small text-muted mt-1">Directly funded into verified relief field programs</div>
                    </div>

                    <div class="p-3 rounded-3 bg-light border mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2 small">
                            <span class="text-muted">Total Donors</span>
                            <strong class="text-dark font-mono">@(Model.TotalMembersCount > 0 ? Model.TotalMembersCount.ToString() : "920+")</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2 small">
                            <span class="text-muted">Completed Transactions</span>
                            <strong class="text-dark font-mono">@(Model.TotalDonationsCount > 0 ? Model.TotalDonationsCount.ToString() : "1,450+")</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small">
                            <span class="text-muted">Accredited NGOs</span>
                            <strong class="text-dark font-mono">@(Model.TotalNgosCount > 0 ? Model.TotalNgosCount.ToString() : "16+")</strong>
                        </div>
                    </div>

                    <a asp-controller="Donation" asp-action="Create" class="btn btn-saas-primary w-100 py-2 fw-semibold rounded-pill">
                        Donate in 60 Seconds <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Impact Metrics Strip -->
<section class="py-4 border-bottom bg-white">
    <div class="container">
        <div class="row g-3 text-center">
            <div class="col-6 col-md-3">
                <div class="p-3">
                    <div class="font-mono fw-bold text-success fs-3">
                        Rs. @(Model.TotalFundsRaised > 0 ? Model.TotalFundsRaised.ToString("N0") : "750,000+")
                    </div>
                    <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Welfare Funded</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3">
                    <div class="font-mono fw-bold text-primary fs-3">
                        @(Model.TotalDonationsCount > 0 ? Model.TotalDonationsCount.ToString() : "1,450+")
                    </div>
                    <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Transactions Settled</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3">
                    <div class="font-mono fw-bold text-warning fs-3">
                        @(Model.TotalMembersCount > 0 ? Model.TotalMembersCount.ToString() : "920+")
                    </div>
                    <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Active Donors</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3">
                    <div class="font-mono fw-bold text-info fs-3">
                        @(Model.TotalNgosCount > 0 ? Model.TotalNgosCount.ToString() : "16+")
                    </div>
                    <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Partner Charities</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Causes Section -->
<section id="causes-section" class="py-5">
    <div class="container py-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4">
            <div>
                <span class="badge bg-success-subtle text-success border border-success-subtle font-mono small mb-1">Direct Impact Portfolios</span>
                <h2 class="fw-bold text-dark mb-1" style="font-size: 1.8rem; letter-spacing: -0.5px;">Urgent Charitable Causes</h2>
                <p class="text-muted small mb-0">Select a welfare sector to directly support verified community projects.</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-controller="Donation" asp-action="Create" class="btn btn-outline-secondary btn-sm fw-semibold">
                    View All Causes <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="row g-4">
            @if (Model.FeaturedCauses.Any())
            {
                @foreach (var cause in Model.FeaturedCauses)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="giveaid-card p-4 bg-white border h-100 d-flex flex-column justify-content-between shadow-sm">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div class="d-flex align-items-center justify-content-center rounded-3 bg-success-subtle text-success" style="width: 44px; height: 44px;">
                                        <i class="bi bi-bookmark-heart-fill fs-5"></i>
                                    </div>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle font-mono small">
                                        Accepting Aid
                                    </span>
                                </div>
                                <h4 class="fw-bold text-dark mb-2" style="font-size: 1.2rem;">@cause.Name</h4>
                                <p class="text-muted small mb-4" style="line-height: 1.6;">@cause.Description</p>
                            </div>
                            <div class="pt-3 border-top">
                                <a asp-controller="Donation" asp-action="Create" asp-route-causeId="@cause.Id" class="btn btn-donate-amber w-100 fw-bold py-2 shadow-sm rounded-pill">
                                    <i class="bi bi-heart-fill me-1 text-danger"></i>Contribute to Cause
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5 text-muted">
                    <p>No active causes published at this time.</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Upcoming Welfare Programmes -->
<section class="py-5 bg-white border-top border-bottom">
    <div class="container py-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4">
            <div>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-mono small mb-1">On-Ground Action</span>
                <h2 class="fw-bold text-dark mb-1" style="font-size: 1.8rem; letter-spacing: -0.5px;">Upcoming Field Campaigns</h2>
                <p class="text-muted small mb-0">Join, volunteer, or support relief camps organized by our verified charity partners.</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-controller="Home" asp-action="Programmes" class="btn btn-saas-secondary btn-sm">
                    Browse All Programmes <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="row g-4">
            @if (Model.UpcomingProgrammes.Any())
            {
                @foreach (var prog in Model.UpcomingProgrammes.Take(3))
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="giveaid-card p-4 bg-light border h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-mono small">
                                        @prog.Category
                                    </span>
                                    <span class="small text-muted font-mono" style="font-size:0.75rem;">
                                        <i class="bi bi-calendar3 me-1 text-success"></i>@prog.EventDate.ToString("MMM dd, yyyy")
                                    </span>
                                </div>
                                <h5 class="fw-bold text-dark mb-2">@prog.Title</h5>
                                <p class="text-muted small mb-3" style="line-height: 1.6;">
                                    @(prog.Description.Length > 110 ? prog.Description.Substring(0, 110) + "…" : prog.Description)
                                </p>
                                @if (prog.Ngo != null)
                                {
                                    <div class="small text-muted mb-3 d-flex align-items-center gap-1">
                                        <i class="bi bi-building text-secondary"></i>
                                        <span>Hosted by <strong>@prog.Ngo.Name</strong></span>
                                    </div>
                                }
                            </div>
                            <div class="pt-3 border-top">
                                <a asp-controller="Programme" asp-action="Details" asp-route-id="@prog.Id" class="btn btn-outline-success btn-sm w-100 rounded-pill fw-semibold">
                                    Express Interest & Volunteer <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-4 text-muted">
                    <p class="small mb-0">No active scheduled campaigns at the moment.</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Why Choose GIVE-AID Feature Grid -->
<section class="py-5">
    <div class="container py-3">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="badge bg-success-subtle text-success border border-success-subtle font-mono small mb-2">Institutional Integrity</span>
            <h2 class="fw-bold text-dark mb-2" style="font-size: 1.8rem; letter-spacing: -0.5px;">Why Give Through GIVE-AID?</h2>
            <p class="text-muted small mb-0">We ensure absolute accountability, rigorous charity partner vetting, and zero hidden deductions.</p>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-4">
                <div class="giveaid-card p-4 bg-white border h-100">
                    <div class="d-flex align-items-center justify-content-center rounded-3 bg-success-subtle text-success mb-3" style="width: 48px; height: 48px;">
                        <i class="bi bi-shield-check fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">100% Vetted Non-Profits</h5>
                    <p class="text-muted small mb-0" style="line-height: 1.6;">
                        Every affiliated NGO undergoes thorough legal documentation and governance audit before listing campaigns on the portal.
                    </p>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="giveaid-card p-4 bg-white border h-100">
                    <div class="d-flex align-items-center justify-content-center rounded-3 bg-warning-subtle text-warning-emphasis mb-3" style="width: 48px; height: 48px;">
                        <i class="bi bi-receipt-cutoff fs-4 text-warning"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Immutable Donation Receipts</h5>
                    <p class="text-muted small mb-0" style="line-height: 1.6;">
                        Review your full contribution history, verify manual bank and mobile wallet transaction proofs, and download receipts anytime.
                    </p>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="giveaid-card p-4 bg-white border h-100">
                    <div class="d-flex align-items-center justify-content-center rounded-3 bg-primary-subtle text-primary mb-3" style="width: 48px; height: 48px;">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Direct Volunteer Participation</h5>
                    <p class="text-muted small mb-0" style="line-height: 1.6;">
                        Connect directly with field personnel, visit on-ground relief camps, and observe firsthand the human lives your generosity touches.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Corporate Partners & Sponsors Grid -->
@if (Model.Partners != null && Model.Partners.Any())
{
    <section class="py-5 bg-white border-top">
        <div class="container text-center">
            <span class="badge bg-light text-muted border font-mono small mb-2">Corporate Alliances</span>
            <h4 class="fw-bold text-dark mb-4" style="font-size: 1.4rem;">Our Corporate & Strategic Sponsors</h4>
            <div class="row justify-content-center align-items-center g-4">
                @foreach (var partner in Model.Partners.Take(6))
                {
                    <div class="col-6 col-md-3 col-lg-2">
                        <div class="p-3 bg-light rounded-3 border text-center d-flex align-items-center justify-content-center" style="height: 70px;">
                            @if (!string.IsNullOrEmpty(partner.LogoPath))
                            {
                                <img src="@partner.LogoPath" alt="@partner.Name" style="max-height: 40px; max-width: 100%; object-fit: contain;" />
                            }
                            else
                            {
                                <span class="fw-bold text-muted small">@partner.Name</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Final Call-to-Action Banner -->
<section class="py-5 text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #0F172A 0%, #064E3B 100%);">
    <div class="container text-center py-4">
        <span class="badge bg-emerald-subtle text-success border border-success-subtle font-mono small mb-2">Collective Philanthropy</span>
        <h2 class="display-6 fw-bold text-white mb-3" style="letter-spacing: -0.5px;">Ready to Make an Everlasting Difference?</h2>
        <p class="lead text-white-50 mb-4" style="max-width: 650px; margin: 0 auto; line-height: 1.7; font-size: 1.05rem;">
            Join over 900+ registered donors and help us provide dignified shelter, nutrition, and emergency healthcare today.
        </p>
        <div class="d-flex justify-content-center flex-wrap gap-3">
            <a asp-controller="Donation" asp-action="Create" class="btn btn-donate-amber btn-lg px-5 py-3 rounded-pill fw-bold shadow">
                <i class="bi bi-heart-fill me-2 text-danger"></i>Contribute Now
            </a>
            <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-light btn-lg px-4 py-3 rounded-pill fw-semibold">
                Join As A Member
            </a>
        </div>
    </div>
</section>
