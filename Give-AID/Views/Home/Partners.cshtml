@model IEnumerable<Give_AID.Models.Partners>
@{
    ViewData["Title"] = "Corporate Sponsors & CSR Partners - GIVE-AID";
}

<!-- Page Header Strip -->
<section class="py-4 border-bottom bg-white">
    <div class="container">
        <div class="d-flex align-items-center gap-2 text-muted small mb-1">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a>
            <span>/</span>
            <span class="text-dark fw-semibold">Corporate Sponsors</span>
        </div>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h2 class="fw-bold mb-1 text-dark" style="font-size: 1.6rem; letter-spacing: -0.5px;">
                    <i class="bi bi-award-fill me-2 text-success"></i>Strategic & Corporate Sponsors
                </h2>
                <p class="text-muted small mb-0">We collaborate with visionary enterprises committed to measurable Corporate Social Responsibility (CSR).</p>
            </div>
            <a asp-controller="Home" asp-action="Contact" class="btn btn-saas-primary btn-sm px-3 rounded-pill fw-semibold">
                <i class="bi bi-envelope-plus me-1"></i>Become a Sponsor
            </a>
        </div>
    </div>
</section>

<div class="container py-5">
    <div class="row g-4 mb-5">
        @if (Model != null && Model.Any())
        {
            @foreach (var partner in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="giveaid-card p-4 text-center h-100 d-flex flex-column justify-content-between bg-white border shadow-sm">
                        <div>
                            <div class="p-3 bg-light rounded-3 mb-3 d-flex align-items-center justify-content-center border" style="height: 100px;">
                                @if (!string.IsNullOrEmpty(partner.LogoPath))
                                {
                                    <img src="@partner.LogoPath" alt="@partner.Name" class="img-fluid" style="max-height: 60px; max-width: 100%; object-fit: contain;" onerror="this.src='/images/placeholder-logo.png';" />
                                }
                                else
                                {
                                    <i class="bi bi-award fs-1 text-success"></i>
                                }
                            </div>
                            <h5 class="fw-bold text-dark mb-1" style="font-size: 1.1rem;">@partner.Name</h5>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-mono small mb-3">
                                Corporate CSR Partner
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(partner.Website))
                        {
                            <div class="pt-2 border-top">
                                <a href="@partner.Website" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                    Visit Partner <i class="bi bi-box-arrow-up-right small ms-1"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="p-5 bg-white rounded-3 shadow-sm border">
                    <i class="bi bi-award display-3 text-muted mb-3 d-inline-block"></i>
                    <h4 class="fw-bold text-dark">Sponsorship Marquee Being Prepared</h4>
                    <p class="text-muted small mb-0">Join our corporate giving program to feature your enterprise CSR initiatives.</p>
                </div>
            </div>
        }
    </div>

    <!-- Partnership Call to Action Banner -->
    <div class="giveaid-card p-4 p-md-5 bg-white border shadow-sm text-center" style="border-left: 4px solid var(--primary-green) !important;">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success mb-3" style="width: 56px; height: 56px;">
            <i class="bi bi-handshake fs-2"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Partner With GIVE-AID on CSR Initiatives</h3>
        <p class="text-muted small mb-4" style="max-width: 650px; margin: 0 auto; line-height: 1.7;">
            We offer institutional matching programs, employee payroll giving integrations, and verified impact analytics for your annual ESG sustainability reporting.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Home" asp-action="Contact" class="btn btn-donate-amber px-4 py-2 rounded-pill fw-bold">
                <i class="bi bi-envelope me-1"></i>Contact CSR Desk
            </a>
            <a asp-controller="Home" asp-action="About" asp-route-slug="our-supporters" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
                Read Corporate Case Studies
            </a>
        </div>
    </div>
</div>
