@model IEnumerable<Give_AID.Models.Partners>
@{
    ViewData["Title"] = "Our Partners - GIVE-AID";
}

<section class="py-4 bg-light border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Our Partners</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-1" style="color: #1E8E5A;">Strategic & Corporate Partners</h2>
        <p class="text-muted mb-0">We collaborate with forward-thinking organizations committed to corporate social responsibility.</p>
    </div>
</section>

<div class="container py-5">
    <div class="row g-4 mb-5">
        @if (Model != null && Model.Any())
        {
            @foreach (var partner in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="giveaid-card p-4 text-center h-100 d-flex flex-column justify-content-between bg-white">
                        <div>
                            <div class="p-4 bg-light rounded-3 mb-3 d-flex align-items-center justify-content-center" style="height: 120px;">
                                @if (!string.IsNullOrEmpty(partner.LogoPath))
                                {
                                    <img src="@partner.LogoPath" alt="@partner.Name" class="img-fluid" style="max-height: 80px;" onerror="this.src='/images/partner-placeholder.png';" />
                                }
                                else
                                {
                                    <i class="bi bi-building fs-1 text-success"></i>
                                }
                            </div>
                            <h5 class="fw-bold mb-2">@partner.Name</h5>
                            <span class="badge bg-success-subtle text-success small mb-3">CSR Partner</span>
                        </div>
                        @if (!string.IsNullOrEmpty(partner.Website))
                        {
                            <div class="mt-2">
                                <a href="@partner.Website" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm w-100">
                                    Visit Website <i class="bi bi-box-arrow-up-right small ms-1"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Default showcase cards when no custom partner records are entered -->
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="giveaid-card p-4 text-center h-100 bg-white">
                    <div class="p-4 bg-light rounded-3 mb-3 d-flex align-items-center justify-content-center" style="height: 120px;">
                        <span class="fs-1 text-success"><i class="bi bi-briefcase-fill"></i></span>
                    </div>
                    <h5 class="fw-bold mb-1">TechWelfare Global</h5>
                    <p class="small text-muted mb-3">Digital classrooms & technology donation partner.</p>
                    <span class="badge bg-success-subtle text-success">Gold Partner</span>
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="giveaid-card p-4 text-center h-100 bg-white">
                    <div class="p-4 bg-light rounded-3 mb-3 d-flex align-items-center justify-content-center" style="height: 120px;">
                        <span class="fs-1 text-primary"><i class="bi bi-capsule"></i></span>
                    </div>
                    <h5 class="fw-bold mb-1">Apex Health Corp</h5>
                    <p class="small text-muted mb-3">Emergency medicine supply & medical camp sponsor.</p>
                    <span class="badge bg-primary-subtle text-primary">Healthcare Partner</span>
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="giveaid-card p-4 text-center h-100 bg-white">
                    <div class="p-4 bg-light rounded-3 mb-3 d-flex align-items-center justify-content-center" style="height: 120px;">
                        <span class="fs-1 text-warning"><i class="bi bi-shield-fill-check"></i></span>
                    </div>
                    <h5 class="fw-bold mb-1">Hope Financial Group</h5>
                    <p class="small text-muted mb-3">100% matched giving on student scholarships.</p>
                    <span class="badge bg-warning-subtle text-warning">Matched Donor</span>
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="giveaid-card p-4 text-center h-100 bg-white">
                    <div class="p-4 bg-light rounded-3 mb-3 d-flex align-items-center justify-content-center" style="height: 120px;">
                        <span class="fs-1 text-info"><i class="bi bi-mortarboard-fill"></i></span>
                    </div>
                    <h5 class="fw-bold mb-1">FutureEd Foundation</h5>
                    <p class="small text-muted mb-3">Vocational training courses and career guidance.</p>
                    <span class="badge bg-info-subtle text-info">Education Partner</span>
                </div>
            </div>
        }
    </div>

    <!-- Partnership Call to Action Card -->
    <div class="giveaid-card p-5 bg-white border-start border-4 border-success text-center">
        <h3 class="fw-bold mb-2">Become a Corporate Partner</h3>
        <p class="lead text-muted col-lg-8 mx-auto mb-4">
            Align your organization with impactful, audited social impact initiatives. Co-create welfare drives, match employee donations, or provide in-kind technological support.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Contact" class="btn btn-primary-green btn-lg px-4 fw-semibold">
                Inquire For Corporate Partnership
            </a>
            <a asp-controller="Home" asp-action="HelpCentre" class="btn btn-outline-secondary btn-lg px-4">
                CSR Guidelines
            </a>
        </div>
    </div>
</div>

