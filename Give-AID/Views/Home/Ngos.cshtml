@model IEnumerable<Give_AID.Models.Ngos>
@{
    ViewData["Title"] = "Verified NGO Partners - GIVE-AID";
}

<!-- Page Header Strip -->
<section class="py-4 border-bottom bg-white">
    <div class="container">
        <div class="d-flex align-items-center gap-2 text-muted small mb-1">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a>
            <span>/</span>
            <span class="text-dark fw-semibold">Accredited Charities</span>
        </div>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h2 class="fw-bold mb-1 text-dark" style="font-size: 1.6rem; letter-spacing: -0.5px;">
                    <i class="bi bi-buildings-fill me-2 text-success"></i>Verified NGO Partners
                </h2>
                <p class="text-muted small mb-0">Learn about our certified non-profit partners operating on the frontlines of humanitarian relief.</p>
            </div>
            <a asp-controller="Donation" asp-action="Create" class="btn btn-donate-amber btn-sm px-3 rounded-pill fw-bold">
                <i class="bi bi-heart-fill me-1 text-danger"></i>Direct a Donation
            </a>
        </div>
    </div>
</section>

<div class="container py-5">
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var ngo in Model)
            {
                <div class="col-12 col-md-6">
                    <div class="giveaid-card p-4 bg-white border h-100 d-flex flex-column justify-content-between shadow-sm">
                        <div>
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="rounded-3 border p-1 bg-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 60px; height: 60px;">
                                    @if (!string.IsNullOrEmpty(ngo.Logo))
                                    {
                                        <img src="@ngo.Logo" alt="@ngo.Name" style="max-width: 100%; max-height: 100%; object-fit: contain;" onerror="this.src='/images/placeholder-ngo.png';" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-building fs-3 text-success"></i>
                                    }
                                </div>
                                <div>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle font-mono small mb-1">
                                        <i class="bi bi-patch-check-fill me-1"></i>Accredited Charity
                                    </span>
                                    <h4 class="fw-bold text-dark mb-0" style="font-size: 1.25rem;">@ngo.Name</h4>
                                </div>
                            </div>

                            <p class="text-muted small mb-3" style="line-height: 1.6;">@ngo.Description</p>

                            <div class="p-3 bg-light rounded-3 small mb-3 border">
                                <div class="d-flex align-items-center gap-2 text-dark">
                                    <i class="bi bi-geo-alt-fill text-danger"></i>
                                    <span><strong>Headquarters & Contact:</strong> @ngo.Contact</span>
                                </div>
                                @if (ngo.Programmes != null && ngo.Programmes.Any())
                                {
                                    <div class="mt-2 pt-2 border-top d-flex align-items-center gap-2 text-dark">
                                        <i class="bi bi-calendar2-check text-primary"></i>
                                        <span><strong>Active Campaigns:</strong> @ngo.Programmes.Count welfare field initiatives</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-2 border-top">
                            <a asp-controller="Donation" asp-action="Create" asp-route-ngoId="@ngo.Id" class="btn btn-donate-amber btn-sm w-100 fw-bold rounded-pill">
                                <i class="bi bi-heart-fill me-1 text-danger"></i>Donate to this NGO
                            </a>
                            <a asp-controller="Home" asp-action="Programmes" class="btn btn-outline-secondary btn-sm px-3 rounded-pill fw-semibold">
                                View Activities
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="p-5 bg-white rounded-3 shadow-sm border">
                    <i class="bi bi-buildings display-3 text-muted mb-3 d-inline-block"></i>
                    <h4 class="fw-bold text-dark">Partner NGOs Being Audited</h4>
                    <p class="text-muted small mb-3">Our governance team is verifying partner accreditations. Check back soon for the verified roster.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-saas-primary btn-sm px-4 rounded-pill">Back to Home</a>
                </div>
            </div>
        }
    </div>
</div>
