@model Give_AID.Models.PageContents
@{
    ViewData["Title"] = "Help Centre & FAQs - GIVE-AID";
}

<section class="py-4 bg-light border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Help Centre</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-1" style="color: #1E8E5A;">Help Centre & Donor Support</h2>
        <p class="text-muted mb-0">Answers to frequently asked questions, donation guidelines, and inquiry assistance.</p>
    </div>
</section>

<div class="container py-5">
    <div class="row g-5">
        <!-- Main Column: FAQs Accordion & CMS overview -->
        <div class="col-lg-8">
            <!-- Dynamic CMS Help Centre text -->
            <div class="giveaid-card p-4 bg-white mb-4">
                <h4 class="fw-bold mb-3" style="color: #1F2937;">@Model.Title</h4>
                <p class="text-muted leading-relaxed mb-0">@Model.Body</p>
            </div>

            <!-- FAQ Accordion -->
            <h4 class="fw-bold mb-3 mt-4">Frequently Asked Questions</h4>
            <div class="accordion shadow-sm rounded-3 overflow-hidden" id="faqAccordion">
                
                <div class="accordion-item border-0 border-bottom">
                    <h2 class="accordion-header" id="headingOne">
                        <button class="accordion-button fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                            1. How does GIVE-AID verify partner NGOs?
                        </button>
                    </h2>
                    <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted small">
                            Every NGO registered with GIVE-AID undergoes a comprehensive vetting process. We review their legal incorporation, tax-exempt certification, audited financial statements for the past 3 years, and conduct on-site inspections of their field projects before they can list welfare programmes or receive public donations.
                        </div>
                    </div>
                </div>

                <div class="accordion-item border-0 border-bottom">
                    <h2 class="accordion-header" id="headingTwo">
                        <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                            2. Are online donations secure and encrypted?
                        </button>
                    </h2>
                    <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted small">
                            Yes. All donation transactions pass through strict encryption protocols. Card information is validated securely, and GIVE-AID never stores your full card number or CVV code in our database. We only record the last 4 digits for donor verification and receipt generation.
                        </div>
                    </div>
                </div>

                <div class="accordion-item border-0 border-bottom">
                    <h2 class="accordion-header" id="headingThree">
                        <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                            3. Can I track my past donations and obtain receipts?
                        </button>
                    </h2>
                    <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted small">
                            Registered donors can log in at any time and visit their "My Donations" portal. There, you can view a comprehensive log of every contribution made, including transaction date, cause supported, amount, and payment status.
                        </div>
                    </div>
                </div>

                <div class="accordion-item border-0 border-bottom">
                    <h2 class="accordion-header" id="headingFour">
                        <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                            4. How can I volunteer or participate in upcoming programmes?
                        </button>
                    </h2>
                    <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted small">
                            Browse the "Programmes" section on our website. When you find an event you wish to support, click "Register Interest" and submit your message. The organizing NGO will review your submission and contact you with volunteer schedules and details.
                        </div>
                    </div>
                </div>

                <div class="accordion-item border-0">
                    <h2 class="accordion-header" id="headingFive">
                        <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFive" aria-expanded="false" aria-controls="collapseFive">
                            5. What if I have a question not covered here?
                        </button>
                    </h2>
                    <div id="collapseFive" class="accordion-collapse collapse" aria-labelledby="headingFive" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted small">
                            Registered donors can raise a direct inquiry through our "My Queries" ticketing feature. Our administrator team will review your question and respond directly to your account dashboard.
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Right Side: Contact & Support Actions -->
        <div class="col-lg-4">
            <div class="giveaid-card p-4 bg-white mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-question-circle text-success me-2"></i>Have a Custom Query?</h5>
                <p class="small text-muted mb-3">
                    Need help with a donation, partnership inquiry, or technical difficulty? Registered donors can submit questions directly to our support desk.
                </p>
                <div class="d-grid gap-2">
                    <a asp-controller="Query" asp-action="Create" class="btn btn-primary-green btn-sm fw-semibold">
                        <i class="bi bi-chat-left-dots me-1"></i>Raise A Query
                    </a>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-envelope me-1"></i>Contact Secretariat
                    </a>
                </div>
            </div>

            <!-- Direct Contact Box -->
            <div class="giveaid-card p-4 bg-light border-0">
                <h6 class="fw-bold text-uppercase small text-muted mb-3">Direct Support Desk</h6>
                <div class="small mb-2">
                    <i class="bi bi-telephone-fill text-success me-2"></i><strong>Phone:</strong> +92 300 1234567
                </div>
                <div class="small mb-2">
                    <i class="bi bi-envelope-fill text-success me-2"></i><strong>Email:</strong> help@giveaid.org
                </div>
                <div class="small text-muted mt-3 pt-3 border-top">
                    <i class="bi bi-clock me-1"></i>Response time: typically within 24-48 business hours.
                </div>
            </div>
        </div>
    </div>
</div>

