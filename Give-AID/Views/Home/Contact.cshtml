@{
    ViewData["Title"] = "Contact Secretariat - GIVE-AID";
}

<!-- Page Header Strip -->
<section class="py-4 border-bottom bg-white">
    <div class="container">
        <div class="d-flex align-items-center gap-2 text-muted small mb-1">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a>
            <span>/</span>
            <span class="text-dark fw-semibold">Contact Us</span>
        </div>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h2 class="fw-bold mb-1 text-dark" style="font-size: 1.6rem; letter-spacing: -0.5px;">
                    <i class="bi bi-geo-alt-fill me-2 text-success"></i>Contact GIVE-AID Secretariat
                </h2>
                <p class="text-muted small mb-0">We are here to answer your questions, facilitate corporate partnerships, and assist your giving journey.</p>
            </div>
            <a asp-controller="Query" asp-action="Create" class="btn btn-donate-amber btn-sm px-3 rounded-pill fw-bold">
                <i class="bi bi-chat-dots-fill me-1"></i>Member Support Ticket
            </a>
        </div>
    </div>
</section>

<div class="container py-5">
    <div class="row g-4">
        <!-- Contact Details Column -->
        <div class="col-12 col-lg-5">
            <div class="giveaid-card p-4 p-md-5 bg-white border h-100 shadow-sm">
                <span class="badge bg-success-subtle text-success border border-success-subtle font-mono small mb-3">
                    <i class="bi bi-building me-1"></i>National Headquarters
                </span>
                <h3 class="fw-bold text-dark mb-4">Main Secretariat</h3>

                <div class="d-flex align-items-start mb-4">
                    <div class="p-3 bg-light rounded-3 text-success fs-4 me-3 border flex-shrink-0">
                        <i class="bi bi-geo-alt-fill text-danger"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Head Office Location</h6>
                        <p class="text-muted small mb-0">Plot 45-C, Main Commercial Avenue, Phase 5, DHA, Karachi, Pakistan</p>
                    </div>
                </div>

                <div class="d-flex align-items-start mb-4">
                    <div class="p-3 bg-light rounded-3 text-success fs-4 me-3 border flex-shrink-0">
                        <i class="bi bi-telephone-fill text-success"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Helpline & Landline</h6>
                        <p class="text-muted small mb-0">+92 300 1234567 / +92 21 35890000</p>
                    </div>
                </div>

                <div class="d-flex align-items-start mb-4">
                    <div class="p-3 bg-light rounded-3 text-success fs-4 me-3 border flex-shrink-0">
                        <i class="bi bi-envelope-fill text-primary"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Direct Correspondence</h6>
                        <p class="text-muted small mb-0">contact@giveaid.org / donorcare@giveaid.org</p>
                    </div>
                </div>

                <div class="d-flex align-items-start">
                    <div class="p-3 bg-light rounded-3 text-success fs-4 me-3 border flex-shrink-0">
                        <i class="bi bi-clock-fill text-warning"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Office Hours</h6>
                        <p class="text-muted small mb-0">Monday – Saturday: 9:00 AM – 6:00 PM PKT<br />Sunday: Closed for field logistics</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact / General Inquiry Form -->
        <div class="col-12 col-lg-7">
            <div class="giveaid-card p-4 p-md-5 bg-white border shadow-sm">
                <h3 class="fw-bold text-dark mb-2">Send a Message to the Secretariat</h3>
                <p class="text-muted small mb-4">Fill out the form below and our humanitarian coordination team will respond within 24 hours.</p>

                <form onsubmit="event.preventDefault(); alert('Thank you for reaching out! Your message has been received by our secretariat team.'); this.reset();">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Your Full Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" required placeholder="John Doe" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Email Address <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" required placeholder="john@example.com" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Contact Phone</label>
                            <input type="tel" class="form-control" placeholder="+92 300 1234567" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Inquiry Department</label>
                            <select class="form-select">
                                <option>General Philanthropic Inquiry</option>
                                <option>Donation & Tax Receipt Support</option>
                                <option>Corporate CSR Partnership</option>
                                <option>NGO Onboarding Verification</option>
                                <option>Field Volunteering Registration</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-dark">Message / Question <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="5" required placeholder="Describe your question, partnership idea, or donation verification request..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-saas-primary px-4 py-2 fw-semibold rounded-pill">
                        <i class="bi bi-send-fill me-1"></i> Send Secretariat Message
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
