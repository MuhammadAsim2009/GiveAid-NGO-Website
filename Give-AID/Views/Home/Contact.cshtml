@{
    ViewData["Title"] = "Contact Us - GIVE-AID";
}

<section class="py-4 bg-light border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Contact Us</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-1" style="color: #1E8E5A;">Contact GIVE-AID Secretariat</h2>
        <p class="text-muted mb-0">We are here to answer your questions, facilitate partnerships, and assist your giving journey.</p>
    </div>
</section>

<div class="container py-5">
    <div class="row g-5">
        <!-- Contact Details -->
        <div class="col-lg-5">
            <div class="giveaid-card p-4 p-md-5 bg-white h-100">
                <span class="badge bg-success-subtle text-success px-3 py-2 mb-3">Headquarters</span>
                <h3 class="fw-bold mb-4" style="color: #1F2937;">Main Secretariat</h3>

                <div class="d-flex align-items-start mb-4">
                    <div class="p-3 bg-light rounded-circle text-success fs-4 me-3">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Location Address</h6>
                        <p class="text-muted small mb-0">Plot 45-C, Main Commercial Avenue, Phase 5, Karachi, Sindh, Pakistan</p>
                    </div>
                </div>

                <div class="d-flex align-items-start mb-4">
                    <div class="p-3 bg-light rounded-circle text-success fs-4 me-3">
                        <i class="bi bi-telephone-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Phone Assistance</h6>
                        <p class="text-muted small mb-0">+92 300 1234567 / +92 21 35890000</p>
                    </div>
                </div>

                <div class="d-flex align-items-start mb-4">
                    <div class="p-3 bg-light rounded-circle text-success fs-4 me-3">
                        <i class="bi bi-envelope-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Email Inquiries</h6>
                        <p class="text-muted small mb-0">contact@giveaid.org / donorcare@giveaid.org</p>
                    </div>
                </div>

                <div class="d-flex align-items-start">
                    <div class="p-3 bg-light rounded-circle text-success fs-4 me-3">
                        <i class="bi bi-clock-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Operating Hours</h6>
                        <p class="text-muted small mb-0">Monday – Saturday: 9:00 AM – 6:00 PM<br />Sunday: Closed</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact / General Inquiry Form -->
        <div class="col-lg-7">
            <div class="giveaid-card p-4 p-md-5 bg-white">
                <h3 class="fw-bold mb-2">Send Us A Message</h3>
                <p class="text-muted small mb-4">Fill out the form below and our team will get back to you within 24 hours.</p>

                <form onsubmit="event.preventDefault(); alert('Thank you for reaching out! Your message has been received.'); this.reset();">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Your Name *</label>
                            <input type="text" class="form-control" required placeholder="John Doe" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Email Address *</label>
                            <input type="email" class="form-control" required placeholder="john@example.com" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Contact Phone</label>
                            <input type="tel" class="form-control" placeholder="+92 300 0000000" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-secondary">Inquiry Topic</label>
                            <select class="form-select">
                                <option>General Inquiry</option>
                                <option>Donation & Tax Receipt Support</option>
                                <option>Corporate CSR Partnership</option>
                                <option>NGO Onboarding Verification</option>
                                <option>Volunteering Opportunities</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-secondary">Your Message *</label>
                        <textarea class="form-control" rows="5" required placeholder="Write your inquiry or feedback here..."></textarea>
                    </div>

                    <button type="submit" class="btn text-white fw-semibold py-2 px-4" style="background-color: #1E8E5A;">
                        <i class="bi bi-send-fill me-1"></i>Send Inquiry
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

