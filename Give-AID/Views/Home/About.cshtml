@model Give_AID.Models.PageContents
@{
    ViewData["Title"] = $"{Model.Title} - GIVE-AID";
    var subPages = ViewBag.SubPages as Dictionary<string, string> ?? new Dictionary<string, string>();
    string currentSlug = ViewBag.CurrentSlug as string ?? "what-we-do";
}

<!-- Page Header Banner -->
<section class="py-4 bg-white border-bottom">
    <div class="container">
        <div class="d-flex align-items-center gap-2 text-muted small mb-1">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a>
            <span>/</span>
            <span class="text-muted">About GIVE-AID</span>
            <span>/</span>
            <span class="text-dark fw-semibold">@Model.Title</span>
        </div>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h2 class="fw-bold mb-0 text-dark" style="font-size: 1.6rem; letter-spacing: -0.5px;">@Model.Title</h2>
                <p class="text-muted small mb-0">Discover our governance structure, mission principles, and humanitarian milestones.</p>
            </div>
            <a asp-controller="Donation" asp-action="Create" class="btn btn-donate-amber btn-sm px-3 rounded-pill fw-bold">
                <i class="bi bi-heart-fill me-1 text-danger"></i>Support Our Mission
            </a>
        </div>
    </div>
</section>

<!-- Content Section with Left Navigation -->
<div class="container py-5">
    <div class="row g-4">
        <!-- Left Sidebar: About Us Sub-pages -->
        <div class="col-12 col-lg-3 col-md-4">
            <div class="giveaid-card p-3 mb-4 bg-white border shadow-sm sticky-top" style="top: 80px;">
                <div class="small fw-bold text-uppercase text-muted font-mono mb-3 px-2" style="font-size: 0.75rem;">
                    Institutional Catalog
                </div>
                <div class="d-flex flex-column gap-1">
                    @foreach (var pageItem in subPages)
                    {
                        bool isActive = currentSlug.Equals(pageItem.Key, StringComparison.OrdinalIgnoreCase);
                        <a asp-controller="Home" asp-action="About" asp-route-slug="@pageItem.Key"
                           class="d-flex justify-content-between align-items-center py-2 px-3 rounded-3 text-decoration-none small fw-semibold transition-all @(isActive ? "bg-success text-white shadow-sm" : "text-secondary hover-bg-light")">
                            <span>@pageItem.Value</span>
                            <i class="bi bi-chevron-right small @(isActive ? "text-white" : "text-muted")"></i>
                        </a>
                    }
                </div>

                <!-- Quick Sidebar Box -->
                <div class="p-3 rounded-3 bg-light border mt-4 text-center">
                    <i class="bi bi-shield-check text-success fs-3 mb-2 d-inline-block"></i>
                    <h6 class="fw-bold text-dark mb-1">Audited Non-Profit</h6>
                    <p class="text-muted small mb-0" style="font-size:0.75rem;">100% of donated capital is deployed strictly to verified charity causes.</p>
                </div>
            </div>
        </div>

        <!-- Right Main Content -->
        <div class="col-12 col-lg-9 col-md-8">
            <div class="giveaid-card p-4 p-md-5 bg-white border shadow-sm">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-success-subtle text-success border border-success-subtle font-mono small">
                        <i class="bi bi-file-earmark-check me-1"></i>Official Welfare Article
                    </span>
                    <span class="text-muted small font-mono" style="font-size: 0.75rem;">
                        <i class="bi bi-clock-history me-1"></i>Updated: @Model.UpdatedAt.ToString("MMM dd, yyyy")
                    </span>
                </div>

                <h1 class="fw-bold mb-4 text-dark" style="font-size: 1.8rem; letter-spacing: -0.5px;">@Model.Title</h1>

                <div class="text-dark lead" style="font-size: 1.05rem; line-height: 1.85;">
                    @Html.Raw(Model.Body.Replace("\n", "<br />"))
                </div>

                <!-- Structured Highlights -->
                <div class="row g-3 mt-4 pt-4 border-top">
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center border h-100">
                            <i class="bi bi-award-fill text-success fs-3 mb-2 d-inline-block"></i>
                            <h6 class="fw-bold text-dark mb-1">Accredited Integrity</h6>
                            <p class="small text-muted mb-0">Certified by national NGO regulatory & charity oversight commissions.</p>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center border h-100">
                            <i class="bi bi-eye-fill text-warning fs-3 mb-2 d-inline-block"></i>
                            <h6 class="fw-bold text-dark mb-1">Absolute Transparency</h6>
                            <p class="small text-muted mb-0">Every contribution is traceable with digital transaction references.</p>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center border h-100">
                            <i class="bi bi-people-fill text-primary fs-3 mb-2 d-inline-block"></i>
                            <h6 class="fw-bold text-dark mb-1">Community First</h6>
                            <p class="small text-muted mb-0">Empowering volunteer networks, clinics, and grassroots schooling.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
