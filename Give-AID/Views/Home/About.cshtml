@model Give_AID.Models.PageContents
@{
    ViewData["Title"] = $"{Model.Title} - About Us";
    var subPages = ViewBag.SubPages as Dictionary<string, string> ?? new Dictionary<string, string>();
    string currentSlug = ViewBag.CurrentSlug as string ?? "what-we-do";
}

<!-- Page Header Banner -->
<section class="py-4 bg-light border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">Home</a></li>
                <li class="breadcrumb-item text-muted">About Us</li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0" style="color: #1E8E5A;">@Model.Title</h2>
    </div>
</section>

<!-- Content Section with Left Navigation -->
<div class="container py-5">
    <div class="row g-4">
        <!-- Left Sidebar: About Us Sub-pages -->
        <div class="col-lg-3 col-md-4">
            <div class="giveaid-card p-3 mb-4">
                <h6 class="fw-bold text-uppercase text-muted small mb-3 px-2">About GIVE-AID</h6>
                <div class="list-group list-group-flush">
                    @foreach (var pageItem in subPages)
                    {
                        bool isActive = currentSlug.Equals(pageItem.Key, StringComparison.OrdinalIgnoreCase);
                        <a asp-controller="Home" asp-action="About" asp-route-slug="@pageItem.Key"
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center rounded-2 py-2 px-3 mb-1 @(isActive ? "active text-white" : "text-secondary")"
                           style="@(isActive ? "background-color: #1E8E5A; border-color: #1E8E5A;" : "")">
                            <span>@pageItem.Value</span>
                            <i class="bi bi-chevron-right small"></i>
                        </a>
                    }
                </div>
            </div>

            <!-- Quick CTA Card in Sidebar -->
            <div class="giveaid-card p-4 text-center" style="background: linear-gradient(135deg, #fef3c7 0%, #e8f5ee 100%);">
                <i class="bi bi-heart-fill fs-2 text-warning mb-2 d-inline-block"></i>
                <h5 class="fw-bold mb-2">Support Our Work</h5>
                <p class="small text-muted mb-3">Your small generosity brings grand transformation to vulnerable communities.</p>
                <a asp-controller="Donation" asp-action="Create" class="btn btn-donate-amber btn-sm w-100 fw-bold">
                    Donate Now
                </a>
            </div>
        </div>

        <!-- Right Main Content -->
        <div class="col-lg-9 col-md-8">
            <div class="giveaid-card p-4 p-md-5 bg-white">
                <div class="d-flex align-items-center gap-2 mb-4">
                    <span class="badge bg-success-subtle text-success px-3 py-2">Official Documentation</span>
                    <span class="text-muted small"><i class="bi bi-clock-history me-1"></i>Updated: @Model.UpdatedAt.ToString("MMM dd, yyyy")</span>
                </div>

                <h2 class="fw-bold mb-4" style="color: #1F2937;">@Model.Title</h2>

                <div class="lead text-secondary mb-4" style="line-height: 1.8;">
                    @Html.Raw(Model.Body.Replace("\n", "<br />"))
                </div>

                <!-- Structured Highlights -->
                <div class="row g-3 mt-4 pt-4 border-top">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <i class="bi bi-award-fill text-success fs-3 mb-2"></i>
                            <h6 class="fw-bold mb-1">Accredited Integrity</h6>
                            <p class="small text-muted mb-0">Certified by national NGO regulatory bodies</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <i class="bi bi-eye-fill text-warning fs-3 mb-2"></i>
                            <h6 class="fw-bold mb-1">Full Transparency</h6>
                            <p class="small text-muted mb-0">Direct fund deployment tracking and reporting</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <i class="bi bi-people-fill text-primary fs-3 mb-2"></i>
                            <h6 class="fw-bold mb-1">Community First</h6>
                            <p class="small text-muted mb-0">Empowering local volunteers and grassroots leadership</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

